<header class="site-header">
  <div class="container">
    <div class="header-logo">
      <a href="/"><%= siteName || '李拾肆博客' %></a>
    </div>

    <nav class="site-nav" id="siteNav">
      <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">首页</a>
      <% categories.forEach(function(cat) { %>
        <% if (cat.slug === 'gallery' || cat.slug === 'home') return; %>
        <a href="/category/<%= cat.slug %>" class="nav-link <%= currentPath && currentPath.startsWith('/category/' + cat.slug) ? 'active' : '' %>"><%= cat.name %></a>
      <% }); %>
      <a href="/gallery" class="nav-link <%= currentPath === '/gallery' ? 'active' : '' %>">图册</a>
      <a href="/tools" class="nav-link <%= currentPath && currentPath.startsWith('/tools') ? 'active' : '' %>">工具</a>
      <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">关于</a>
      <a href="/message" class="nav-link <%= currentPath === '/message' ? 'active' : '' %>">留言</a>
      <div class="mobile-search">
        <form class="search-box" action="/search" method="GET">
          <input type="text" name="q" class="search-input" placeholder="搜索文章..." autocomplete="off">
          <button type="submit" class="search-btn" aria-label="搜索">
            <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          </button>
        </form>
      </div>
    </nav>

    <div class="header-search">
      <form class="search-box" action="/search" method="GET">
        <input type="text" name="q" class="search-input" placeholder="搜索文章..." autocomplete="off">
        <button type="submit" class="search-btn" aria-label="搜索">
          <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        </button>
      </form>
    </div>

    <button class="hamburger" id="hamburgerBtn" aria-label="菜单">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>
