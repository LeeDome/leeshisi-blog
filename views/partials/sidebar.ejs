<aside class="sidebar">
  <div class="sidebar-card author-card">
    <img class="author-avatar" src="<%= authorAvatar || '/images/default-avatar.svg' %>" alt="头像">
    <h3 class="author-name"><%= author && author.nickname ? author.nickname : '博主' %></h3>
    <% if (author && author.bio) { %>
      <p class="author-bio"><%= author.bio %></p>
    <% } %>
  </div>

  <% if (locals.recentComments && recentComments.length > 0) { %>
  <div class="sidebar-card">
    <h4 class="sidebar-title">最近评论</h4>
    <ul class="recent-comments">
      <% recentComments.forEach(function(comment) { %>
      <li class="rc-item">
        <div class="rc-item-head">
          <img class="rc-avatar" src="<%= comment.is_author ? (authorAvatar || '/images/default-avatar.svg') : gravatar(comment.email, 32) %>" alt="<%= comment.nickname %>">
          <div class="rc-item-info">
            <span class="rc-nickname"><%= comment.nickname %></span>
            <span class="rc-time"><%= comment.created_at %></span>
          </div>
        </div>
        <% if (comment.articleTitle) { %>
        <p class="rc-article">评论了 <a href="/article/<%= comment.article_id %>"><%= comment.articleTitle %></a></p>
        <% } %>
        <p class="rc-snippet"><%= comment.content && comment.content.length > 60 ? comment.content.substring(0, 60) + '...' : comment.content %></p>
      </li>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <% if (locals.hotArticles && hotArticles.length > 0) { %>
  <div class="sidebar-card">
    <h4 class="sidebar-title">热门主题</h4>
    <ul class="hot-articles">
      <% hotArticles.forEach(function(article) { %>
      <li class="hot-item">
        <a href="/article/<%= article.id %>"><%= article.title %></a>
      </li>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <% if (locals.archives && archives.length > 0) { %>
  <div class="sidebar-card">
    <h4 class="sidebar-title">归档</h4>
    <ul class="archives">
      <% archives.forEach(function(archive) { %>
      <li class="archive-item">
        <a href="/archive/<%= archive.yearMonth %>"><%= archive.year %>年<%= archive.month %>月 (<%= archive.count %>)</a>
      </li>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <% if (locals.tagCloud && tagCloud.length > 0) { %>
  <div class="sidebar-card">
    <h4 class="sidebar-title">标签</h4>
    <div class="tag-cloud">
      <% var counts = tagCloud.map(function(t) { return Number(t.count) || 0; }); %>
      <% var maxCount = Math.max.apply(null, counts); %>
      <% var minCount = Math.min.apply(null, counts); %>
      <% var spread = maxCount - minCount; %>
      <% tagCloud.forEach(function(tag) { %>
        <% var fontSize = spread > 0
              ? 11 + Math.round(((Number(tag.count) - minCount) / spread) * 9)
              : 14; %>
        <a href="/tag/<%= tag.id %>" class="tag-item" style="font-size: <%= fontSize %>px;"><%= tag.name %></a>
      <% }); %>
    </div>
  </div>
  <% } %>

  <div class="sidebar-card">
    <h4 class="sidebar-title">站点运行时间</h4>
    <p class="site-runtime" id="siteRuntime" data-start="<%= locals.siteStartTime || '' %>">计算中...</p>
  </div>
</aside>