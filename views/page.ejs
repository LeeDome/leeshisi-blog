<% if (locals.page) { %>
<div class="page-detail">
  <header class="page-header">
    <h1 class="page-title"><%= page.title %></h1>
  </header>

  <div class="page-content">
    <%- page.content %>
  </div>
</div>

<div class="comments-section" id="comments">
  <% if (locals.comment_submitted) { %>
  <div class="comment-success">评论提交成功，审核后将会显示</div>
  <% } %>
  <div class="comments-header">
    <h3 class="comments-title">评论 (<%= commentTotal || 0 %>)</h3>
  </div>

  <div class="comment-form-wrap">
    <h4 class="comment-form-title">发表评论</h4>
    <form class="comment-form" action="/comment" method="POST">
      <input type="hidden" name="page_type" value="<%= page.slug %>">
      <div class="comment-form-row">
        <input type="email" name="email" class="comment-input" placeholder="邮箱 *" required>
        <input type="text" name="nickname" class="comment-input" placeholder="昵称 *" required>
        <input type="url" name="website" class="comment-input" placeholder="网站（可选）">
      </div>
      <textarea name="content" class="comment-textarea" placeholder="写下你的评论..." required></textarea>
      <button type="submit" class="comment-submit-btn">提交评论</button>
    </form>
  </div>

  <% if (locals.comments && comments.length > 0) { %>
  <ul class="comment-list">
    <% comments.forEach(function(comment) { %>
      <%- include('_comment-item', { comment: comment, page: page, votedCommentMap: votedCommentMap, gravatar: gravatar }) %>
    <% }); %>
  </ul>

  <% if (locals.commentTotalPages && commentTotalPages > 1) { %>
  <div class="load-more-comments-wrap">
    <button type="button" class="load-more-comments-btn" data-next-page="<%= commentPage + 1 %>" data-loaded="false">加载更多评论</button>
  </div>
  <% } %>

  <% } else { %>
  <div class="empty-state">
    <p>暂无评论，快来抢沙发吧！</p>
  </div>
  <% } %>
</div>

<script>
(function() {
  // ========== 评论投票状态本地缓存 ==========
  // 从服务端注入已投票的评论 ID 和对应类型
  var votedComments = <%- typeof votedCommentMap !== 'undefined' ? JSON.stringify(votedCommentMap) : '{}'%>;
  function getVoteKey(commentId, type) {
    return 'cv_' + commentId + '_' + type;
  }
  function setVote(commentId, type) {
    localStorage.setItem(getVoteKey(commentId, type), '1');
  }
  function clearVote(commentId, type) {
    localStorage.removeItem(getVoteKey(commentId, type));
  }
  function hasVote(commentId, type) {
    return localStorage.getItem(getVoteKey(commentId, type)) === '1' || votedComments[commentId] === type;
  }

  // 初始化按钮 active 状态（服务端投票状态）
  document.querySelectorAll('.comment-like-btn').forEach(function(btn) {
    var id = btn.dataset.commentId;
    if (votedComments[id] === 'like') btn.classList.add('active');
  });
  document.querySelectorAll('.comment-dislike-btn').forEach(function(btn) {
    var id = btn.dataset.commentId;
    if (votedComments[id] === 'dislike') btn.classList.add('active');
  });

  // 管理员昵称（受保护，不允许评论者使用相同昵称），页面加载时获取
  var PROTECTED_NICKNAME = <%- JSON.stringify(author && author.nickname ? author.nickname : '') %>;

  // 后端返回的昵称冲突错误提示
  <% if (locals.comment_error === 'protected_nickname') { %>
  if (typeof showToast === 'function') showToast('该昵称与博主昵称重合，请更换昵称');
  <% } %>

  // 评论频率限制 / IP 拉黑提示
  <% if (locals.comment_error === 'too_frequent') { %>
  if (typeof showToast === 'function') showToast('发言频繁，请稍后再试');
  <% } %>
  <% if (locals.comment_error === 'blacklisted') { %>
  if (typeof showToast === 'function') showToast('发言过于频繁，已被暂时限制，请稍后重试');
  <% } %>

  // 校验昵称不与管理员昵称重合
  function guardNickname(input) {
    var val = (input.value || '').trim();
    var form = input.closest('form');
    if (!form) return;
    if (val && PROTECTED_NICKNAME && (val === PROTECTED_NICKNAME || val.toLowerCase() === String(PROTECTED_NICKNAME).toLowerCase())) {
      input.setCustomValidity && input.setCustomValidity('该昵称已被占用，请更换');
      showToast && showToast('该昵称与博主昵称重合，请更换昵称');
      form.dataset.guarded = '1';
    } else {
      input.setCustomValidity && input.setCustomValidity('');
      if (form) form.dataset.guarded = '';
    }
  }

  // 评论交互事件统一绑定（支持对动态加载的评论局部重新绑定）
  function bindCommentActions(scope) {
    // 昵称保护：输入完成后即时校验
    scope.querySelectorAll('.comment-input[name="nickname"]').forEach(function(input) {
      input.addEventListener('input', function() { guardNickname(this); });
      input.addEventListener('blur', function() { guardNickname(this); });
    });
    scope.querySelectorAll('form.comment-form, form[action="/comment"]').forEach(function(form) {
      form.addEventListener('submit', function(ev) {
        var n = form.querySelector('input[name="nickname"]');
        if (n && form.dataset.guarded === '1') {
          ev.preventDefault();
          showToast && showToast('该昵称与博主昵称重合，请更换昵称');
          return;
        }
        // 局部刷新：AJAX 提交评论，成功后把新评论插入评论区，不清空整页
        ev.preventDefault();
        var btn = form.querySelector('.comment-submit-btn');
        if (btn) btn.disabled = true;

        var body = new URLSearchParams(new FormData(form)).toString();
        fetch('/comment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: body
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (btn) btn.disabled = false;
            if (data.success) {
              var textarea = form.querySelector('textarea[name="content"]');
              if (textarea) textarea.value = '';
              var wrap = document.createElement('div');
              wrap.innerHTML = data.html;
              var node = wrap.children[0];
              if (!node) { if (showToast) showToast('评论已提交'); return; }

              if (data.parentId) {
                // 子回复：追加到父评论的 children 容器
                var children = document.getElementById('comment-children-' + data.parentId);
                if (children) { children.appendChild(node); }
                else { var replyForm = document.getElementById('reply-form-' + data.parentId); if (replyForm && replyForm.parentNode) replyForm.parentNode.insertBefore(node, replyForm.nextSibling); }
              } else {
                // 顶级评论：插入到列表头部
                var list = document.getElementById('comments');
                var ul = list.querySelector('.comment-list');
                if (ul) { ul.insertBefore(node, ul.firstChild); }
                else { var empty = list.querySelector('.empty-state'); if (empty) empty.remove(); ul = document.createElement('ul'); ul.className = 'comment-list'; list.insertBefore(ul, list.querySelector('.comment-form-wrap')); ul.appendChild(node); }
              }
              // 更新评论数
              var title = document.querySelector('.comments-title');
              if (title) {
                var m = /[（(]?\s*(\d+)\s*[）)]?/.exec(title.textContent);
                var cur = m ? parseInt(m[1]) : 0;
                title.textContent = title.textContent.replace(/\d+/, cur + 1);
              }
              // 重新绑定动态插入的元素事件、渲染 markdown 依赖（mermaid 等）
              bindCommentActions(node.parentNode || node);
              if (typeof initMermaidIn === 'function') initMermaidIn([node]);
              if (showToast) showToast('评论已提交');
            } else {
              if (showToast) showToast(data.message || '评论失败，请重试');
            }
          })
          .catch(function() {
            if (btn) btn.disabled = false;
            if (showToast) showToast('提交失败，请重试');
          });
      });
    });
    scope.querySelectorAll('.comment-reply-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var commentId = this.dataset.commentId;
        var form = document.getElementById('reply-form-' + commentId);
        if (form) {
          form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
      });
    });

    scope.querySelectorAll('.comment-like-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var commentId = this.dataset.commentId;
        if (hasVote(commentId, 'like')) return;
        // 如果已经点过踩，不允许再点赞
        if (hasVote(commentId, 'dislike')) {
          alert('已点踩，不能再点赞');
          return;
        }
        setVote(commentId, 'like');
        btn.classList.add('active');
        var dislikeBtn = btn.parentElement.querySelector('.comment-dislike-btn');
        if (dislikeBtn) dislikeBtn.classList.remove('active');
        fetch('/comment/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'comment_id=' + commentId
        }).then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success) {
              var countSpan = btn.querySelector('span');
              countSpan.textContent = data.like_count;
            } else {
              clearVote(commentId, 'like');
              btn.classList.remove('active');
              if (data.message) alert(data.message);
            }
          })
          .catch(function() {
            clearVote(commentId, 'like');
            btn.classList.remove('active');
          });
      });
    });

    scope.querySelectorAll('.comment-dislike-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var commentId = this.dataset.commentId;
        if (hasVote(commentId, 'dislike')) return;
        // 如果已经点过赞，不允许再点踩
        if (hasVote(commentId, 'like')) {
          alert('已点赞，不能再点踩');
          return;
        }
        setVote(commentId, 'dislike');
        btn.classList.add('active');
        var likeBtn = btn.parentElement.querySelector('.comment-like-btn');
        if (likeBtn) likeBtn.classList.remove('active');
        fetch('/comment/dislike', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'comment_id=' + commentId
        }).then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success) {
              var countSpan = btn.querySelector('span');
              countSpan.textContent = data.dislike_count;
            } else {
              clearVote(commentId, 'dislike');
              btn.classList.remove('active');
              if (data.message) alert(data.message);
            }
          })
          .catch(function() {
            clearVote(commentId, 'dislike');
            btn.classList.remove('active');
          });
      });
    });

    // ========== QQ 邮箱自动填充昵称 ==========
    scope.querySelectorAll('.comment-form input[name="email"]').forEach(function(emailInput) {
      emailInput.addEventListener('input', function() {
        var form = this.closest('form');
        var nicknameInput = form.querySelector('input[name="nickname"]');
        if (!nicknameInput || nicknameInput.value.trim() !== '') return;

        var match = this.value.trim().match(/^(\d+)@qq\.com$/);
        if (!match) return;

        var qq = match[1];
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/qq-info?qq=' + qq, true);
        xhr.onload = function() {
          if (xhr.status === 200) {
            var data = JSON.parse(xhr.responseText);
            if (data.success) {
              nicknameInput.value = data.nickname;
            }
          }
        };
        xhr.send();
      });
    });

    // 子回复加载更多
    scope.querySelectorAll('.load-more-replies-btn[data-loaded="false"]').forEach(function(btn) {
      btn.setAttribute('data-loaded', 'true'); // 防止重复绑定
      btn.addEventListener('click', function() {
        loadMoreReplies(this);
      });
    });
  }

  function initMermaidIn(containers) {
    if (!containers || containers.length === 0) return;
    var mermaidNodes = [];
    containers.forEach(function(content) {
      if (!content) return;
      var pres = content.querySelectorAll('pre');
      pres.forEach(function(pre) {
        var code = pre.querySelector('code');
        var text = code ? (code.textContent || code.innerText) : pre.textContent;
        text = text.trim();
        if (!text) return;
        var mText = null;
        if (/^(graph |sequenceDiagram|classDiagram|erDiagram|gantt|flowchart |pie )/.test(text)) {
          mText = text;
        }
        if (text.indexOf('pie showData') === 0) {
          mText = text.replace(/^pie showData\s*\n\s*title\s+/, 'pie title ');
        }
        if (mText) {
          var div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = mText;
          pre.parentNode.replaceChild(div, pre);
          mermaidNodes.push(div);
        }
      });
    });

    if (mermaidNodes.length === 0) return;
    if (!Object.hasOwn) {
      Object.hasOwn = function(obj, prop) {
        return Object.prototype.hasOwnProperty.call(obj, prop);
      };
    }

    function runMermaid() {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'default',
        themeVariables: {
          primaryColor: '#e5e7eb',
          primaryTextColor: '#2a2c32',
          primaryBorderColor: '#9ca3af',
          lineColor: '#6b7280',
          secondaryColor: '#f3f4f6',
          tertiaryColor: '#f9fafb'
        }
      });
      mermaid.run({ nodes: mermaidNodes, suppressErrors: true }).then(function() {
        mermaidNodes.forEach(function(div) {
          if (div.parentNode && !div.querySelector('svg')) {
            var pre = document.createElement('pre');
            pre.className = 'mermaid-fallback';
            var code = document.createElement('code');
            code.textContent = div.textContent;
            pre.appendChild(code);
            div.parentNode.replaceChild(pre, div);
          }
        });
        setTimeout(function() {
          mermaidNodes.forEach(function(div) {
            var svg = div.querySelector('svg');
            if (svg) {
              var vb = svg.getAttribute('viewBox');
              if (vb && svg.textContent.indexOf('pie') !== -1) {
                var parts = vb.split(/\s+/).map(Number);
                if (parts.length === 4) {
                  parts[0] = -60;
                  parts[2] = parts[2] + 120;
                  svg.setAttribute('viewBox', parts.join(' '));
                }
              }
            }
          });
        }, 100);
      });
    }

    if (typeof mermaid !== 'undefined') {
      runMermaid();
    } else {
      var s = document.createElement('script');
      s.src = '/lib/mermaid/mermaid.min.js';
      s.onload = runMermaid;
      document.body.appendChild(s);
    }
  }

  // 加载某个根评论下的更多子回复
  function loadMoreReplies(btn) {
    if (btn.disabled) return; // 防止快速双击导致重复请求
    btn.disabled = true;
    var rootId = btn.dataset.rootId;
    var nextPage = parseInt(btn.dataset.nextPage || '1');
    var target = document.getElementById('comment-children-' + rootId);
    var url = '/comment/load?page_type=<%= page.slug %>&root_id=' + rootId + '&child_page=' + nextPage;
    fetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.html) {
          // 直接把返回的 <li> 追加到当前根评论的 children 容器末尾，避免嵌套产生多余的边框
          var frag = document.createElement('div');
          frag.innerHTML = data.html;
          // children 是 live 集合，先快照再逐个移动，否则边移动边遍历会跳项丢失节点
          var nodes = Array.prototype.slice.call(frag.children);
          var inserted = [];
          nodes.forEach(function(node) {
            // 按 id 去重：页面已存在同 id 评论则跳过（如新评论插入导致分页偏移时的重叠）
            if (node.id && document.getElementById(node.id)) return;
            if (target) {
              target.appendChild(node);
            } else if (btn.parentNode) {
              btn.parentNode.insertBefore(node, btn);
            }
            bindCommentActions(node);
            inserted.push(node);
          });
          // 在真正插入 DOM 的节点上渲染 mermaid
          if (inserted.length > 0) initMermaidIn(inserted);
          if (data.remaining > 0) {
            btn.dataset.nextPage = data.nextPage;
            btn.textContent = '展开更多回复 (' + data.remaining + ')';
            btn.disabled = false;
          } else {
            if (btn.parentNode) btn.parentNode.removeChild(btn);
          }
        } else {
          btn.disabled = false;
        }
      })
      .catch(function() { btn.textContent = '加载失败，点击重试'; btn.disabled = false; });
  }

  // 顶级评论加载更多
  function loadMoreComments(btn) {
    if (btn.disabled) return; // 防止快速双击导致重复请求
    btn.disabled = true;
    var nextPage = parseInt(btn.dataset.nextPage || '1');
    var list = document.getElementById('comments');
    var url = '/comment/load?page_type=<%= page.slug %>&page=' + nextPage;
    fetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.html) {
          var wrap = document.createElement('div');
          wrap.innerHTML = data.html;
          // 追加到评论列表末尾（先快照，wrap.children 是 live 集合，边移动边遍历会跳项丢失节点）
          var target = document.querySelector('.comment-list') || null;
          var nodes = Array.prototype.slice.call(wrap.children);
          var inserted = [];
          nodes.forEach(function(node) {
            // 按 id 去重：页面已存在同 id 评论则跳过（如新评论插入导致分页偏移时的重叠）
            if (node.id && document.getElementById(node.id)) return;
            if (target) target.appendChild(node);
            else list.insertBefore(node, btn);
            bindCommentActions(node);
            inserted.push(node);
          });
          // 在真正插入 DOM 的节点上渲染 mermaid
          if (inserted.length > 0) initMermaidIn(inserted);
          if (data.hasMore) {
            btn.dataset.nextPage = data.nextPage;
            btn.disabled = false;
          } else {
            btn.parentNode.removeChild(btn);
          }
        } else {
          btn.disabled = false;
        }
      })
      .catch(function() { btn.textContent = '加载失败，点击重试'; btn.disabled = false; });
  }

  // 绑定顶级评论加载更多
  var loadMoreTopBtn = document.querySelector('.load-more-comments-btn[data-loaded="false"]');
  if (loadMoreTopBtn) {
    loadMoreTopBtn.setAttribute('data-loaded', 'true');
    loadMoreTopBtn.addEventListener('click', function() { loadMoreComments(this); });
  }

  // 初始绑定评论交互 + 渲染初始 mermaid
  bindCommentActions(document);
  initMermaidIn([document.querySelector('.page-content'), document.getElementById('comments')]);
})();
</script>

<% } else { %>
<div class="empty-state">
  <p>页面不存在</p>
</div>
<% } %>