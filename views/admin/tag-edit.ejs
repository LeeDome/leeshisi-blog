<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= tag ? '编辑标签' : '新建标签' %> - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags" class="active">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <h2><%= tag ? '编辑标签' : '新建标签' %></h2>

    <div class="panel">
      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="<%= tag ? '/admin/tags/' + tag.id : '/admin/tags' %>" class="inline-form">
        <div class="form-group">
          <label for="name">名称</label>
          <input type="text" id="name" name="name" value="<%= tag ? tag.name || '' : '' %>" required placeholder="标签名称">
        </div>
        <div class="form-group">
          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" value="<%= tag ? tag.slug || '' : '' %>" placeholder="留空自动生成">
        </div>
        <div>
          <button type="submit" class="btn btn-primary">保存</button>
          <a href="/admin/tags" class="btn btn-cancel">取消</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>