<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>页面管理 - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages" class="active">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/ai">AI 站长</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <h2>页面管理</h2>

    <div class="panel">
      <table>
        <thead>
          <tr>
            <th>标题</th>
            <th>Slug</th>
            <th>更新时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof pages !== 'undefined' && pages.length > 0) { %>
            <% pages.forEach(function(page) { %>
            <tr>
              <td><strong><%= page.title %></strong></td>
              <td><%= page.slug %></td>
              <td><%= new Date(page.updated_at).toLocaleDateString('zh-CN') %></td>
              <td>
                <a href="/admin/pages/<%= page.id %>/edit" class="btn btn-primary btn-sm">编辑</a>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="4" class="text-muted" style="text-align:center;">暂无页面</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>