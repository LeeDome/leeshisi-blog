<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>文章管理 - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles" class="active">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <div class="page-header">
      <h2>文章管理</h2>
      <a href="/admin/articles/new" class="btn btn-primary">+ 新建文章</a>
    </div>

    <div class="panel">
      <table>
        <thead>
          <tr>
            <th>标题</th>
            <th>分类</th>
            <th>状态</th>
            <th>阅读量</th>
            <th>评论数</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
            <% articles.forEach(function(article) { %>
            <tr>
              <td><strong><%= article.title %></strong></td>
              <td><%= article.category_name || '-' %></td>
              <td><span class="badge <%= article.status === 'published' ? 'badge-published' : 'badge-draft' %>"><%= article.status === 'published' ? '已发布' : '草稿' %></span></td>
              <td><%= article.view_count || 0 %></td>
              <td><%= article.comment_count || 0 %></td>
              <td><%= new Date(article.created_at).toLocaleDateString('zh-CN') %></td>
              <td class="actions">
                <a href="/admin/articles/<%= article.id %>/edit" class="btn btn-primary btn-sm">编辑</a>
                <form method="POST" action="/admin/articles/<%= article.id %>/delete" style="display:inline" onsubmit="return confirm('确定要删除这篇文章吗？')">
                  <button type="submit" class="btn btn-danger btn-sm">删除</button>
                </form>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="7" class="text-muted" style="text-align:center;">暂无文章</td></tr>
          <% } %>
        </tbody>
      </table>

      <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>">上一页</a>
        <% } else { %>
          <span class="disabled">上一页</span>
        <% } %>
        <span class="current"><%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>">下一页</a>
        <% } else { %>
          <span class="disabled">下一页</span>
        <% } %>
      </div>
      <% } %>
    </div>
  </main>
</body>
</html>