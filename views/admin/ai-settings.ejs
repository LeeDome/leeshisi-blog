<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI 站长 - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .provider-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 16px;
    }
    .provider-card h3 {
      margin: 0 0 12px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .provider-card .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 12px;
      background: #e8f5e9;
      color: #2e7d32;
    }
    .provider-card .badge.multimodal {
      background: #e3f2fd;
      color: #1565c0;
    }
    .provider-card .badge.disabled {
      background: #f5f5f5;
      color: #999;
    }
    .function-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin: 8px 0;
    }
    .function-tag {
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 12px;
      background: #f3e5f5;
      color: #7b1fa2;
    }
    .function-tag.reply { background: #e8f5e9; color: #2e7d32; }
    .function-tag.moderate { background: #fff3e0; color: #e65100; }
    .function-tag.polish { background: #e3f2fd; color: #1565c0; }
    .provider-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }
    .provider-actions .btn-danger {
      background: #d32f2f;
      color: #fff;
      border: none;
      padding: 6px 14px;
      border-radius: 4px;
      cursor: pointer;
    }
    .provider-actions .btn-danger:hover { background: #b71c1c; }
    .preset-link {
      display: inline-block;
      margin-top: 4px;
      font-size: 12px;
      color: #1976d2;
    }
    .preset-link:hover { text-decoration: underline; }
    /* ===== 供应商配置表单卡片 ===== */
.provider-form-card {
      background: #fff;
      border: 1px solid #e8ecf2;
      border-radius: 14px;
      margin-bottom: 24px;
      box-shadow: 0 2px 12px rgba(30, 41, 59, 0.05);
      overflow: hidden;
    }
    .provider-form-card .pf-accent {
      height: 4px;
      background: linear-gradient(90deg, #4096ff, #36cfc9, #b37feb, #4096ff);
      background-size: 300% 100%;
      animation: pf-flow 8s linear infinite;
    }
    @keyframes pf-flow { to { background-position: 300% 0; } }
    .pf-head {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 20px 24px 14px;
    }
    .pf-head .pf-icon {
      width: 42px;
      height: 42px;
      flex-shrink: 0;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #4096ff, #1677ff);
      box-shadow: 0 4px 10px rgba(22, 119, 255, 0.25);
      color: #fff;
    }
    .pf-head .pf-icon svg { width: 22px; height: 22px; }
    .pf-head h3 { margin: 0; font-size: 17px; color: #1f2d3d; }
    .pf-head p { margin: 3px 0 0; font-size: 12px; color: #94a3b8; }
    .pf-body { padding: 2px 24px 22px; }
    .pf-group-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      letter-spacing: .04em;
      margin: 18px 0 12px;
    }
    .pf-group-title::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, #e2e8f0, transparent);
    }
    .pf-group-title .pf-num {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      border-radius: 50%;
      background: #e8f4ff;
      color: #1677ff;
      font-size: 11px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .form-row { display: flex; gap: 14px; margin-bottom: 0; }
    .form-row .form-group { flex: 1; min-width: 0; }
    .form-row-3 .form-group { flex: 1; min-width: 0; }
    /* 多模态复选框：与同行输入框对齐 */
    .multimodal-check {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 38px;
      padding: 0 12px;
      box-sizing: border-box;
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      background: #fbfcfe;
      font-size: 14px;
      font-weight: normal;
      color: #334155;
      cursor: pointer;
      margin-bottom: 0;
      transition: border-color .18s, box-shadow .18s;
    }
    .multimodal-check:hover { border-color: #4096ff; background: #fff; }
    .multimodal-check:has(input:checked) {
      border-color: #1677ff;
      background: #f0f7ff;
      box-shadow: inset 0 0 0 1px #1677ff;
    }
    .multimodal-check input {
      width: 16px; height: 16px;
      margin: 0;
      accent-color: #1677ff;
      flex-shrink: 0;
      cursor: pointer;
    }
    /* ===== 供应商配置模态框 ===== */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      z-index: 1000;
      overflow-y: auto;
      padding: 36px 16px;
    }
    .modal-overlay.show { display: flex; align-items: flex-start; justify-content: center; }
    .modal-overlay .provider-form-card { margin-bottom: 0; width: 100%; max-width: 720px; }
    .pf-close {
      margin-left: auto;
      width: 32px; height: 32px;
      flex-shrink: 0;
      border: none; border-radius: 8px;
      background: #f1f5f9;
      color: #64748b;
      font-size: 18px; line-height: 1;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all .18s ease;
    }
    .pf-close:hover { background: #e2e8f0; color: #334155; }
    /* 添加供应商按钮 */
    .btn-add-provider {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      background: linear-gradient(135deg, #4096ff, #1677ff);
      color: #fff;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(22, 119, 255, 0.25);
      transition: all .2s ease;
      white-space: nowrap;
    }
    .btn-add-provider:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(22, 119, 255, 0.32); }
    .form-group input[type="number"] {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      font-size: 14px;
      background: #fbfcfe;
      transition: border-color .18s, box-shadow .18s;
    }
    .form-group input[type="number"]:focus {
      outline: none;
      border-color: #4096ff;
      box-shadow: 0 0 0 3px rgba(64, 150, 255, 0.12);
      background: #fff;
    }
    /* 模型 ID 自定义下拉 */
    .model-input-wrap { position: relative; }
    .model-input-wrap input { padding-right: 32px; }
    .model-dd-arrow {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      color: #94a3b8;
      pointer-events: none;
    }
    .model-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(30, 41, 59, 0.14);
      max-height: 220px;
      overflow-y: auto;
      z-index: 60;
    }
    .model-dropdown.show { display: block; }
    .model-dropdown .md-item {
      padding: 8px 12px;
      font-size: 13px;
      color: #334155;
      cursor: pointer;
      font-family: Consolas, Monaco, monospace;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .model-dropdown .md-item:hover, .model-dropdown .md-item.md-active {
      background: #f0f7ff;
      color: #1677ff;
    }
    .model-dropdown .md-empty {
      padding: 10px 12px;
      font-size: 12px;
      color: #94a3b8;
    }
    /* 预设模板按钮 */
    .provider-select-btns { display: flex; gap: 10px; flex-wrap: wrap; }
    .provider-select-btns button {
      padding: 8px 16px;
      border: 1px solid #e2e8f0;
      border-radius: 999px;
      background: #fff;
      cursor: pointer;
      font-size: 13px;
      color: #475569;
      transition: all .18s ease;
    }
    .provider-select-btns button:hover {
      border-color: #4096ff;
      color: #1677ff;
      background: #f5faff;
      transform: translateY(-1px);
      box-shadow: 0 3px 8px rgba(22, 119, 255, 0.10);
    }
    .provider-select-btns button.active {
      background: linear-gradient(135deg, #4096ff, #1677ff);
      border-color: transparent;
      color: #fff;
      box-shadow: 0 4px 10px rgba(22, 119, 255, 0.28);
    }
    /* 功能复选卡片 */
    .function-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 12px;
    }
    .function-card {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 14px;
      cursor: pointer;
      background: #fff;
      transition: all .18s ease;
    }
    .function-card:hover { border-color: #91caff; background: #f8fbff; }
    .function-card:has(input:checked) {
      border-color: #1677ff;
      background: #f0f7ff;
      box-shadow: inset 0 0 0 1px #1677ff;
    }
    .function-card input { margin-top: 3px; accent-color: #1677ff; width: 15px; height: 15px; flex-shrink: 0; }
    .function-card .fc-title { font-size: 13px; font-weight: 600; color: #334155; }
    .function-card .fc-desc { font-size: 12px; color: #94a3b8; margin-top: 2px; line-height: 1.5; }
    /* 底部操作栏 */
    .pf-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 24px;
      background: #fafbfc;
      border-top: 1px solid #eef2f6;
    }
    .pf-footer .pf-footer-hint { margin-left: auto; font-size: 12px; color: #94a3b8; }
    .btn-save {
      min-width: 160px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 24px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      background: linear-gradient(135deg, #4096ff, #1677ff);
      color: #fff;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(22, 119, 255, 0.25);
      transition: all .2s ease;
    }
    .btn-save:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(22, 119, 255, 0.32); }
    .btn-save:disabled { opacity: .8; cursor: not-allowed; transform: none; }
    .btn-spinner {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #fff;
      animation: pf-spin .7s linear infinite;
      display: inline-block;
      flex-shrink: 0;
    }
    @keyframes pf-spin { to { transform: rotate(360deg); } }
    .empty-state {
      text-align: center;
      padding: 40px;
      color: #999;
    }
    .badge-reply { background: #e8f5e9; color: #2e7d32; padding:2px 8px; border-radius:4px; font-size:12px; }
    .badge-moderate { background: #fff3e0; color: #e65100; padding:2px 8px; border-radius:4px; font-size:12px; }
  </style>
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/ai" class="active">AI 站长</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>
    <% if (locals.error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <h2>AI 站长</h2>

    <!-- 功能说明 -->
    <div class="panel" style="margin-bottom:20px;background:#f8f9ff;border:1px solid #d0d7ff;">
      <div style="padding:16px 20px;">
        <h3 style="margin:0 0 8px 0;font-size:15px;color:#1a237e;">AI 站长是什么？</h3>
        <p style="margin:0 0 12px 0;font-size:13px;color:#444;line-height:1.6;">
          配置一个 AI 供应商（如 DeepSeek、GLM 等），让它成为你的博客助手，自动完成评论回复、内容审核、文章润色等工作。
        </p>
        <h4 style="margin:0 0 6px 0;font-size:13px;color:#333;">可用功能说明：</h4>
        <table style="font-size:13px;color:#444;width:100%;border-collapse:collapse;">
          <tr style="border-bottom:1px solid #e0e0e0;">
            <td style="padding:8px 12px 8px 0;width:80px;vertical-align:top;"><span class="function-tag reply">评论回复</span></td>
            <td style="padding:8px 0;line-height:1.5;">
              用户发表评论后，AI 会自动回复。如果是回复 AI 的评论，AI 会查看完整对话历史（含文章内容）后回复。<br>
              <span style="color:#888;font-size:12px;">注意：用户互相回复不会触发 AI 回复，只有直接与 AI 对话才会持续交流。</span>
            </td>
          </tr>
          <tr style="border-bottom:1px solid #e0e0e0;">
            <td style="padding:8px 12px 8px 0;width:80px;vertical-align:top;"><span class="function-tag moderate">评论审核</span></td>
            <td style="padding:8px 0;line-height:1.5;">
              用户发表评论后，AI 自动检测是否为广告、辱骂、违法言论，若违规则自动禁用该评论（非删除，后台可恢复）。<br>
              <span style="color:#888;font-size:12px;">注意：每条评论只审核一次，审核通过后不再重复检测。</span>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 12px 8px 0;width:80px;vertical-align:top;"><span class="function-tag polish">文章润色</span></td>
            <td style="padding:8px 0;line-height:1.5;">
              在编辑文章时，点击工具栏的「AI 润色」按钮，AI 会生成优化后的文本，弹出模态框对比确认后替换原文。
            </td>
          </tr>
        </table>
        <div style="margin-top:12px;padding:10px 14px;background:#fff;border-radius:6px;border:1px solid #e8e8e8;font-size:13px;color:#555;line-height:1.6;">
          <strong style="color:#d32f2f;">提示：</strong>点击「已配置的 AI 供应商」右侧的「添加 AI 供应商」按钮，选择预置模板（或自定义），填写 API Key 和模型 ID，勾选需要的功能，保存即可开始使用。
        </div>
      </div>
    </div>

    <!-- 已有配置列表 -->
    <div class="panel">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <h3 style="margin:0;">已配置的 AI 供应商</h3>
        <button type="button" class="btn-add-provider" onclick="openProviderModal(true)">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          添加 AI 供应商
        </button>
      </div>
      <% if (providers && providers.length > 0) { %>
        <% providers.forEach(function(p) { %>
          <div class="provider-card">
            <h3>
              <%= p.name %>
              <% var funcs = []; try { funcs = JSON.parse(p.functions || '[]'); } catch(e) {} %>
              <% if (funcs.length > 0) { %>
                <span class="badge">已启用</span>
              <% } else { %>
                <span class="badge disabled">未启用</span>
              <% } %>
              <% if (p.is_multimodal) { %><span class="badge multimodal">多模态</span><% } %>
            </h3>
            <div style="font-size:13px;color:#666;margin-bottom:4px;">
              模型: <%= p.model_id %> | 接口: <code style="background:#f5f5f5;padding:1px 4px;border-radius:2px;font-size:12px;"><%= p.api_url %></code>
            </div>
            <div style="font-size:12px;color:#999;margin-bottom:8px;">
              输入上限: <%= p.input_tokens ? p.input_tokens + ' token' : '不限制' %> | 输出上限: <%= p.output_tokens ? p.output_tokens + ' token' : '默认' %> | 思考模式: <%= p.thinking_mode ? '开启' : '关闭' %>
            </div>
            <div class="function-tags">
              <% if (funcs.indexOf('reply') !== -1) { %><span class="function-tag reply">评论回复</span><% } %>
              <% if (funcs.indexOf('moderate') !== -1) { %><span class="function-tag moderate">评论审核</span><% } %>
              <% if (funcs.indexOf('polish') !== -1) { %><span class="function-tag polish">文章润色</span><% } %>
            </div>
            <div class="provider-actions">
              <button type="button" class="btn btn-sm" onclick="editProvider(<%= p.id %>)">编辑</button>
              <form method="POST" action="/admin/ai/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('确认删除该配置？')">
                <button type="submit" class="btn btn-danger btn-sm">删除</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <p>暂无 AI 配置</p>
          <p style="font-size:13px;color:#aaa;">点击右上角「添加 AI 供应商」按钮开始使用</p>
        </div>
      <% } %>
    </div>

    <!-- AI 评论防护（配额 / 批量 / 限流） -->
    <div class="panel" style="margin-top:24px;">
      <h3>评论 AI 防护</h3>
      <p style="font-size:13px;color:#888;margin-bottom:14px;">防止评论被无限刷、AI token 被刷爆。审核与回复均已纳入配额与批量处理，未审核评论按「批量间隔」合并为一次 AI 调用统一审核。</p>
      <p style="font-size:13px;color:#666;margin:-8px 0 14px;line-height:1.7;">处理流程：评论入库后先进入「批量审核」——只有<strong>通过审核</strong>（不违规）的评论，才会在<strong>本轮审核完成后</strong>再逐个触发 AI 回复；未审核、被判定违规的评论一律不会回复。因此 AI 回复会有最多一个「批量审核间隔」的延迟。若某轮审核未通过，则不会回复该评论。</p>
      <form method="POST" action="/admin/ai/config">
        <table class="table">
          <thead>
            <tr><th>配置项</th><th>值</th><th>今日用量</th><th>说明</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>每日最大审核条数</td>
              <td><input type="number" min="0" name="daily_moderate_limit" value="<%= aiConfig.daily_moderate_limit %>" style="width:90px;padding:5px 8px;border:1px solid #d9e2ec;border-radius:6px;" /></td>
              <td><%= moderateToday %> / <%= aiConfig.daily_moderate_limit === '0' ? '不限' : aiConfig.daily_moderate_limit %></td>
              <td>0 = 不限制；超出后当天不再 AI 审核</td>
            </tr>
            <tr>
              <td>每日最大 AI 回复条数</td>
              <td><input type="number" min="0" name="daily_reply_limit" value="<%= aiConfig.daily_reply_limit %>" style="width:90px;padding:5px 8px;border:1px solid #d9e2ec;border-radius:6px;" /></td>
              <td><%= replyToday %> / <%= aiConfig.daily_reply_limit === '0' ? '不限' : aiConfig.daily_reply_limit %></td>
              <td>0 = 不限制；超出后当天不再自动回复</td>
            </tr>
            <tr>
              <td>批量审核间隔（分钟）</td>
              <td><input type="number" min="1" name="moderate_batch_interval_min" value="<%= aiConfig.moderate_batch_interval_min %>" style="width:90px;padding:5px 8px;border:1px solid #d9e2ec;border-radius:6px;" /></td>
              <td>—</td>
              <td>每 N 分钟将未审核评论合并为一次调用审核</td>
            </tr>
            <tr>
              <td>每分钟单 IP 最大评论数</td>
              <td><input type="number" min="1" name="rate_limit_per_minute" value="<%= aiConfig.rate_limit_per_minute %>" style="width:90px;padding:5px 8px;border:1px solid #d9e2ec;border-radius:6px;" /></td>
              <td>—</td>
              <td>超过则提示「发言频繁，请稍后」</td>
            </tr>
            <tr>
              <td>频繁触发拉黑阈值（次）</td>
              <td><input type="number" min="1" name="rate_limit_blacklist_threshold" value="<%= aiConfig.rate_limit_blacklist_threshold %>" style="width:90px;padding:5px 8px;border:1px solid #d9e2ec;border-radius:6px;" /></td>
              <td>—</td>
              <td>连续触发限流达到该次数即拉黑该 IP</td>
            </tr>
            <tr>
              <td>拉黑时长（小时）</td>
              <td><input type="number" min="1" name="rate_limit_blacklist_hours" value="<%= aiConfig.rate_limit_blacklist_hours %>" style="width:90px;padding:5px 8px;border:1px solid #d9e2ec;border-radius:6px;" /></td>
              <td>—</td>
              <td>被拉黑 IP 在此时长内无法评论</td>
            </tr>
          </tbody>
        </table>
        <div style="margin-top:12px;">
          <button type="submit" class="btn btn-primary">保存防护配置</button>
        </div>
      </form>
    </div>

    <!-- MCP（联网工具）配置 -->
    <div class="panel" style="margin-top:24px;">
      <h3>MCP 配置</h3>
      <p style="font-size:13px;color:#888;margin-bottom:14px;">为 Agent 提供联网工具。当前支持 <strong>Tavily</strong> 网络搜索 —— AI 在需要准确、最新信息时会自动联网检索后再回答，无需在回复中说明。</p>

      <div style="display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;padding:14px;border:1px solid #d9e2ec;border-radius:10px;">
        <div style="flex:1;min-width:240px;">
          <div style="display:flex;align-items:center;gap:8px;font-weight:600;">
            Tavily
            <span class="function-tag vision">网络搜索</span>
            <% if (mcpTavily && mcpTavily.enabled) { %>
              <span style="font-size:12px;color:#00b578;">● 已启用<%= mcpTavily.updated_at ? '（' + mcpTavily.updated_at + '）' : '' %></span>
            <% } else { %>
              <span style="font-size:12px;color:#bbb;">● 未启用</span>
            <% } %>
          </div>
          <p style="font-size:12px;color:#999;margin:6px 0 0;">
            文档：<a href="https://docs.tavily.com/documentation/api-reference/endpoint/search" target="_blank" rel="noopener" style="color:#1677ff;">docs.tavily.com</a>。
            填写 API Key 保存时，系统会先测试连通性，测试通过才生效。
          </p>
        </div>
        <div style="flex-shrink:0;display:flex;flex-direction:column;gap:8px;">
          <form method="POST" action="/admin/ai/mcp" style="display:flex;gap:8px;">
            <input type="password" name="api_key" placeholder="<%= mcpTavily && mcpTavily.enabled ? '已启用，填新 Key 可更新' : '粘贴 Tavily API Key' %>" style="padding:7px 10px;border:1px solid #d9e2ec;border-radius:8px;font-size:13px;width:240px;" required />
            <button type="submit" class="btn btn-primary btn-sm">启用更新</button>
          </form>
          <% if (mcpTavily && mcpTavily.enabled) { %>
            <form method="POST" action="/admin/ai/mcp/disable" onsubmit="return confirm('确定禁用 Tavily 网络搜索？')">
              <button type="submit" class="btn btn-sm btn-danger">禁用</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 功能 → 供应商分配 -->
    <div class="panel" style="margin-top:24px;">
      <h3>功能分配</h3>
      <p style="font-size:13px;color:#888;margin-bottom:14px;">为每个功能指定使用哪个 AI 供应商。若某功能留空为「自动」，将回退到在启用该功能的配置中选取最新添加的一个。</p>
      <form method="POST" action="/admin/ai/functions">
        <table class="table">
          <thead>
            <tr>
              <th style="width:120px;">功能</th>
              <th style="width:160px;">说明</th>
              <th>使用的 AI 供应商</th>
            </tr>
          </thead>
          <tbody>
            <% [
              { key: 'reply', label: '评论回复', desc: 'AI 自动回复用户评论' },
              { key: 'moderate', label: '评论审核', desc: '自动检测广告、辱骂等并禁用' },
              { key: 'polish', label: '文章润色', desc: '编辑文章时辅助写作' }
            ].forEach(function(f) { %>
            <tr>
              <td><span class="function-tag <%= f.key %>"><%= f.label %></span></td>
              <td style="font-size:12px;color:#999;"><%= f.desc %></td>
              <td>
                <select name="<%= f.key %>" style="padding:7px 10px;border:1px solid #d9e2ec;border-radius:8px;font-size:13px;width:100%;max-width:380px;">
                  <option value="">— 自动（最新优先）—</option>
                  <% (providers || []).forEach(function(p) { %>
                    <option value="<%= p.id %>" <%= String(functionMap[f.key]) === String(p.id) ? 'selected' : '' %>>
                      <%= p.name %>（<%= p.model_id %>）
                    </option>
                  <% }); %>
                </select>
                <% if (functionMap[f.key]) { %>
                  <span style="font-size:12px;color:#1677ff;margin-left:8px;">已指定</span>
                <% } %>
              </td>
            </tr>
            <% }); %>
            <tr>
              <td><span class="function-tag vision">视觉辅助</span></td>
              <td style="font-size:12px;color:#999;">识别文章图片内容（须为已开启多模态的供应商）</td>
              <td>
                <select name="vision" style="padding:7px 10px;border:1px solid #d9e2ec;border-radius:8px;font-size:13px;width:100%;max-width:380px;">
                  <option value="">— 暂无 —</option>
                  <% (providers || []).filter(function(p) { return p.is_multimodal; }).forEach(function(p) { %>
                    <option value="<%= p.id %>" <%= String(functionMap.vision) === String(p.id) ? 'selected' : '' %>>
                      <%= p.name %>（<%= p.model_id %>）
                    </option>
                  <% }); %>
                </select>
                <% if (functionMap.vision) { %>
                  <span style="font-size:12px;color:#1677ff;margin-left:8px;">已指定</span>
                <% } else { %>
                  <span style="font-size:12px;color:#bbb;margin-left:8px;">未配置</span>
                <% } %>
              </td>
            </tr>
          </tbody>
        </table>
        <div style="margin-top:14px;">
          <button type="submit" class="btn btn-primary btn-sm">保存功能分配</button>
        </div>
      </form>
    </div>

    <!-- 添加/编辑配置表单（模态框） -->
    <div class="modal-overlay" id="providerModal">
      <div class="provider-form-card" id="providerForm">
      <div class="pf-accent"></div>
      <div class="pf-head">
        <div class="pf-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
            <circle cx="12" cy="16" r="1"></circle>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
          </svg>
        </div>
        <div>
          <h3 id="formTitle">添加 AI 供应商</h3>
          <p>填入 API 信息，保存时将向模型发送「你好」测试连通性</p>
        </div>
        <button type="button" class="pf-close" onclick="closeProviderModal(true)" title="关闭">&times;</button>
      </div>
      <form method="POST" action="/admin/ai" id="providerFormInner">
        <input type="hidden" id="edit_id" name="id" value="">
        <div class="pf-body">

          <div class="pf-group-title"><span class="pf-num">1</span>选择供应商模板</div>
          <div class="form-group">
            <div class="provider-select-btns" id="presetBtns">
              <button type="button" data-type="custom" data-url="" data-website="" data-input="" data-output="" data-thinking="0">自定义</button>
              <% for (var key in presets) { %>
                <button type="button" data-type="<%= key %>" data-url="<%= presets[key].apiUrl %>" data-website="<%= presets[key].website %>" data-input="<%= presets[key].inputTokens %>" data-output="<%= presets[key].outputTokens %>" data-thinking="<%= presets[key].thinking ? '1' : '0' %>">
                  <%= presets[key].name %>
                </button>
              <% } %>
            </div>
            <div id="presetWebsite" style="display:none;margin-top:8px;">
              <a href="#" target="_blank" id="presetWebsiteLink" style="font-size:12px;color:#1976d2;">前往官网获取 API Key</a>
            </div>
          </div>

          <div class="pf-group-title"><span class="pf-num">2</span>基础配置</div>
          <div class="form-group">
            <label for="name">配置名称</label>
            <input type="text" id="name" name="name" placeholder="例如：我的 DeepSeek" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="provider_type">供应商类型</label>
              <select id="provider_type" name="provider_type">
                <option value="custom">自定义</option>
                <option value="deepseek">DeepSeek</option>
                <option value="glm">智谱 GLM</option>
                <option value="openai">OpenAI</option>
                <option value="moonshot">月之暗面 Moonshot</option>
                <option value="qwen">通义千问 Qwen</option>
                <option value="agnes">Agnes</option>
              </select>
            </div>
            <div class="form-group">
            <label for="model_id">模型 ID</label>
            <div class="model-input-wrap">
              <input type="text" id="model_id" name="model_id" placeholder="例如: deepseek-chat" required autocomplete="off">
              <svg class="model-dd-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              <div class="model-dropdown" id="modelDropdown"></div>
            </div>
            <span class="help-text" id="modelListHint">填入 API 地址和密钥后自动加载模型列表，点击输入框可选择</span>
          </div>
          </div>

          <div class="form-group">
            <label for="api_url">API 地址</label>
            <input type="text" id="api_url" name="api_url" placeholder="例如: https://api.deepseek.com/v1" required>
            <span class="help-text">OpenAI 兼容格式，无需添加 /chat/completions 后缀</span>
          </div>

          <div class="form-group">
            <label for="api_key">API 密钥</label>
            <input type="password" id="api_key" name="api_key" placeholder="sk-xxxxxx" required>
            <span class="help-text">填入地址和密钥后自动加载可用模型列表</span>
          </div>

          <div class="pf-group-title"><span class="pf-num">3</span>上下文限制</div>
          <div class="form-row form-row-3">
            <div class="form-group">
              <label for="input_tokens">上下文窗口（输入）</label>
              <input type="number" id="input_tokens" name="input_tokens" min="0" step="1000" placeholder="如 65536">
              <span class="help-text">留空则不限制；超出后自动截断较长输入</span>
            </div>
            <div class="form-group">
              <label for="output_tokens">输出 token 上限</label>
              <input type="number" id="output_tokens" name="output_tokens" min="0" step="1000" placeholder="如 8192">
              <span class="help-text">所有 AI 调用的最大输出长度</span>
            </div>
            <div class="form-group">
              <label for="thinking_mode">思考模式</label>
              <select id="thinking_mode" name="thinking_mode">
                <option value="0">关闭</option>
                <option value="1">开启</option>
              </select>
              <span class="help-text">适用于推理模型，开启后传入 Thinking 参数</span>
            </div>
            <div class="form-group">
              <label for="is_multimodal">模型能力</label>
              <label class="multimodal-check" for="is_multimodal">
                <input type="checkbox" name="is_multimodal" value="1" id="is_multimodal">
                <span>多模态模型</span>
              </label>
              <span class="help-text">支持图像 URL 输入的模型请勾选</span>
            </div>
          </div>

          <div class="pf-group-title"><span class="pf-num">4</span>功能分配</div>
          <div class="function-cards">
            <label class="function-card">
              <input type="checkbox" name="functions" value="reply">
              <span>
                <span class="fc-title">评论回复</span>
                <span class="fc-desc" style="display:block;">AI 自动回复用户评论，支持多轮对话上下文</span>
              </span>
            </label>
            <label class="function-card">
              <input type="checkbox" name="functions" value="moderate">
              <span>
                <span class="fc-title">评论审核</span>
                <span class="fc-desc" style="display:block;">自动检测广告、辱骂、违法内容并禁用</span>
              </span>
            </label>
            <label class="function-card">
              <input type="checkbox" name="functions" value="polish">
              <span>
                <span class="fc-title">文章润色</span>
                <span class="fc-desc" style="display:block;">编辑文章时 AI 优化、续写、摘要</span>
              </span>
            </label>
          </div>

        </div>
        <div class="pf-footer">
          <button type="submit" class="btn-save" id="saveBtn">保存配置</button>
          <button type="button" class="btn btn-cancel" id="cancelEdit" style="display:none;" onclick="closeProviderModal(true)">取消编辑</button>
          <span class="pf-footer-hint">保存时将向模型发送测试消息，请稍候</span>
        </div>
      </form>
      </div>
    </div>

    <!-- AI 操作记录 -->
    <div class="panel" style="margin-top:24px;">
      <h3>AI 操作记录</h3>

      <!-- 筛选条件 -->
      <div style="margin-bottom:16px;">
        <form method="GET" action="/admin/ai" style="display:flex;gap:12px;align-items:center;">
          <label style="font-size:13px;color:#555;">筛选类型：</label>
          <select name="type" style="padding:6px 10px;border:1px solid #ddd;border-radius:4px;font-size:13px;">
            <option value="all" <%= logType === 'all' ? 'selected' : '' %>>全部</option>
            <option value="reply" <%= logType === 'reply' ? 'selected' : '' %>>回复</option>
            <option value="moderate" <%= logType === 'moderate' ? 'selected' : '' %>>审核</option>
          </select>
          <button type="submit" class="btn btn-sm">筛选</button>
        </form>
      </div>

      <% if (logs && logs.length > 0) { %>
      <table class="table">
        <thead>
          <tr>
            <th>类型</th>
            <th>评论内容</th>
            <th>AI 回复/结果</th>
            <th>耗时</th>
            <th>状态</th>
            <th>时间</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(log) { %>
          <tr>
            <td>
              <% if (log.action_type === 'reply') { %>
                <span class="badge badge-reply">回复</span>
              <% } else if (log.action_type === 'moderate') { %>
                <span class="badge badge-moderate">审核</span>
              <% } %>
            </td>
            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <%= log.comment_text ? log.comment_text.substring(0, 60) : (log.request_content ? log.request_content.substring(0, 60) : '-') %>
            </td>
            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <%= log.response_content ? log.response_content.substring(0, 80) : '-' %>
            </td>
            <td><%= log.duration ? log.duration + 'ms' : '-' %></td>
            <td>
              <% if (log.result === 'ok') { %>
                <span class="status-badge status-success">通过</span>
              <% } else if (log.result === 'violation') { %>
                <span class="status-badge status-danger">违规</span>
              <% } else if (log.result === 'error') { %>
                <span class="status-badge status-warning">失败</span>
              <% } %>
            </td>
            <td style="font-size:12px;color:#999;"><%= log.created_at %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <!-- 分页 -->
      <% if (logTotalPages > 1) { %>
      <div class="pagination" style="margin-top:16px;text-align:center;">
        <% if (logPage > 1) { %>
          <a href="?page=<%= logPage - 1 %>&type=<%= logType %>" class="pagination-link pagination-prev">&laquo; 上一页</a>
        <% } %>
        <span style="padding:0 12px;font-size:13px;color:#666;"><%= logPage %> / <%= logTotalPages %></span>
        <% if (logPage < logTotalPages) { %>
          <a href="?page=<%= logPage + 1 %>&type=<%= logType %>" class="pagination-link pagination-next">下一页 &raquo;</a>
        <% } %>
      </div>
      <% } %>

      <% } else { %>
        <div class="empty-state">
          <p>暂无 AI 操作记录</p>
          <p style="font-size:13px;color:#aaa;">配置 AI 并启用功能后，操作记录将显示在这里</p>
        </div>
      <% } %>
    </div>
  </main>

  <script>
  // 预设供应商点击填充
  document.querySelectorAll('#presetBtns button').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var type = this.dataset.type;
      var url = this.dataset.url;
      var website = this.dataset.website;

      // 高亮当前选中模板
      document.querySelectorAll('#presetBtns button').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');

      document.getElementById('provider_type').value = type;
      document.getElementById('api_url').value = url;

      // 自动填入默认上下文限制与思考模式
      document.getElementById('input_tokens').value = this.dataset.input || '';
      document.getElementById('output_tokens').value = this.dataset.output || '';
      document.getElementById('thinking_mode').value = this.dataset.thinking || '0';

      // 显示官网引导链接
      var websiteDiv = document.getElementById('presetWebsite');
      var link = document.getElementById('presetWebsiteLink');
      if (website) {
        link.href = website;
        websiteDiv.style.display = 'block';
      } else {
        websiteDiv.style.display = 'none';
      }
    });
  });

  // 根据 API 地址 + 密钥自动加载模型列表
  var fetchModelsTimer = null;
  var loadedModels = [];
  function fetchModels() {
    var url = document.getElementById('api_url').value.trim();
    var key = document.getElementById('api_key').value.trim();
    var hint = document.getElementById('modelListHint');
    if (!url || !key) {
      loadedModels = [];
      hideModelDropdown();
      hint.textContent = '填入 API 地址和密钥后自动加载模型列表';
      return;
    }
    hint.textContent = '正在加载模型列表…';
    fetch('/admin/ai/models', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: url, key: key })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.success && data.models && data.models.length > 0) {
        loadedModels = data.models;
        hint.textContent = '已加载 ' + data.models.length + ' 个模型，点击输入框下拉选择或手动输入';
        if (!document.getElementById('model_id').value) {
          document.getElementById('model_id').value = data.models[0];
        }
        // 若下拉正展开，刷新其内容
        if (document.getElementById('modelDropdown').classList.contains('show')) {
          renderModelDropdown();
        }
      } else {
        loadedModels = [];
        hint.textContent = '未获取到模型列表（' + (data.message || '接口无数据') + '），可手动输入模型 ID';
      }
    }).catch(function(err) {
      hint.textContent = '加载模型列表失败，可手动输入模型 ID';
    });
  }

  // ===== 模型 ID 自定义下拉（原生 datalist 在空输入时单击不弹出，改为自绘） =====
  function renderModelDropdown() {
    var dd = document.getElementById('modelDropdown');
    var q = document.getElementById('model_id').value.trim().toLowerCase();
    var models = loadedModels.filter(function(m) {
      return !q || m.toLowerCase().indexOf(q) !== -1;
    });
    dd.innerHTML = '';
    if (models.length === 0) {
      var empty = document.createElement('div');
      empty.className = 'md-empty';
      empty.textContent = loadedModels.length === 0 ? '尚未加载模型列表（填入 API 地址和密钥后自动加载）' : '无匹配模型，可直接手动输入';
      dd.appendChild(empty);
      return;
    }
    models.forEach(function(m) {
      var item = document.createElement('div');
      item.className = 'md-item';
      item.textContent = m;
      // mousedown + preventDefault：避免点击前输入框先失焦导致下拉被收起
      item.addEventListener('mousedown', function(e) {
        e.preventDefault();
        document.getElementById('model_id').value = m;
        hideModelDropdown();
      });
      dd.appendChild(item);
    });
  }
  function showModelDropdown() {
    renderModelDropdown();
    document.getElementById('modelDropdown').classList.add('show');
  }
  function hideModelDropdown() {
    document.getElementById('modelDropdown').classList.remove('show');
  }
  document.getElementById('model_id').addEventListener('focus', showModelDropdown);
  document.getElementById('model_id').addEventListener('input', function() {
    if (document.getElementById('modelDropdown').classList.contains('show')) {
      renderModelDropdown();
    }
  });
  document.getElementById('model_id').addEventListener('blur', function() {
    setTimeout(hideModelDropdown, 120);
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      hideModelDropdown();
      closeProviderModal(true);
    }
  });

  // ===== 供应商配置模态框 =====
  function openProviderModal(isAdd) {
    if (isAdd) resetForm();
    document.getElementById('providerModal').classList.add('show');
    document.body.style.overflow = 'hidden';
  }
  function closeProviderModal(reset) {
    document.getElementById('providerModal').classList.remove('show');
    document.body.style.overflow = '';
    if (reset) resetForm();
  }
  // 点击遮罩空白处关闭
  document.getElementById('providerModal').addEventListener('click', function(e) {
    if (e.target === this) closeProviderModal(true);
  });

  ['api_url', 'api_key'].forEach(function(id) {
    document.getElementById(id).addEventListener('input', function() {
      clearTimeout(fetchModelsTimer);
      fetchModelsTimer = setTimeout(fetchModels, 600);
    });
  });

  // 保存按钮等待动画：提交后向模型发送测试消息期间禁用按钮并显示 spinner
  document.getElementById('providerFormInner').addEventListener('submit', function() {
    var btn = document.getElementById('saveBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="btn-spinner"></span>正在测试模型连通性…';
    var cancelBtn = document.getElementById('cancelEdit');
    if (cancelBtn) cancelBtn.disabled = true;
  });

  // 编辑已有配置
  var providersData = <%- JSON.stringify(providers || []) %>;
  function editProvider(id) {
    var p = providersData.find(function(item) { return item.id === id; });
    if (!p) return;

    document.getElementById('formTitle').textContent = '编辑 AI 供应商';
    document.getElementById('edit_id').value = p.id;
    document.getElementById('name').value = p.name;
    document.getElementById('provider_type').value = p.provider_type;
    document.getElementById('api_url').value = p.api_url;
    document.getElementById('api_key').value = p.api_key;
    document.getElementById('model_id').value = p.model_id;

    // 设置功能复选框
    var funcs = [];
    try { funcs = JSON.parse(p.functions || '[]'); } catch(e) {}
    document.querySelectorAll('input[name="functions"]').forEach(function(cb) {
      cb.checked = funcs.indexOf(cb.value) !== -1;
    });

    document.querySelector('input[name="is_multimodal"]').checked = p.is_multimodal === 1;

    // 上下文限制与思考模式
    document.getElementById('input_tokens').value = p.input_tokens || '';
    document.getElementById('output_tokens').value = p.output_tokens || '';
    document.getElementById('thinking_mode').value = p.thinking_mode ? '1' : '0';

    // 显示官网链接
    var websiteDiv = document.getElementById('presetWebsite');
    var link = document.getElementById('presetWebsiteLink');
    var presets = <%- JSON.stringify(presets) %>;
    if (presets[p.provider_type]) {
      link.href = presets[p.provider_type].website;
      websiteDiv.style.display = 'block';
    } else {
      websiteDiv.style.display = 'none';
    }

    document.getElementById('cancelEdit').style.display = 'inline-block';

    // 编辑时依据已填地址/密钥也尝试加载模型列表，并以模态框形式打开
    setTimeout(fetchModels, 200);
    openProviderModal(false);
  }

  function resetForm() {
    document.getElementById('formTitle').textContent = '添加 AI 供应商';
    document.getElementById('edit_id').value = '';
    document.getElementById('name').value = '';
    document.getElementById('provider_type').value = 'custom';
    document.getElementById('api_url').value = '';
    document.getElementById('api_key').value = '';
    document.getElementById('model_id').value = '';
    document.querySelectorAll('input[name="functions"]').forEach(function(cb) { cb.checked = false; });
    document.querySelector('input[name="is_multimodal"]').checked = false;
    document.getElementById('input_tokens').value = '';
    document.getElementById('output_tokens').value = '';
    document.getElementById('thinking_mode').value = '0';
    document.getElementById('presetWebsite').style.display = 'none';
    document.getElementById('cancelEdit').style.display = 'none';
    // 清除模板高亮与模型列表
    document.querySelectorAll('#presetBtns button').forEach(function(b) { b.classList.remove('active'); });
    loadedModels = [];
    hideModelDropdown();
    document.getElementById('modelListHint').textContent = '填入 API 地址和密钥后自动加载模型列表，点击输入框可选择';
  }
  </script>
</body>
</html>