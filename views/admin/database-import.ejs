<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>导入数据库 - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/ai">AI 站长</a>
      <a href="/admin/database" class="active">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <h2>导入数据库</h2>

    <div class="panel" style="max-width: 560px;">
      <div style="background:#fff7e6;border:1px solid #ffd591;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#d46b08;font-size:14px;">
        <strong>警告：</strong>导入操作将<strong>覆盖当前所有数据</strong>（文章、评论、分类、标签等），导入前请先完成备份。
      </div>

      <form method="POST" action="/admin/database/import" enctype="multipart/form-data" id="importForm">
        <div class="form-group">
          <label for="db_file">选择数据库文件</label>
          <input type="file" id="db_file" name="db_file" accept=".db,.sqlite" required>
          <span class="help-text">选择之前备份的 .db 文件</span>
        </div>

        <div class="form-group">
          <label for="confirm">确认操作</label>
          <input type="text" id="confirm" name="confirm" placeholder="请输入「确认进行导入」" required>
          <span class="help-text">请输入上方文字以确认您了解此操作的破坏性</span>
        </div>

        <div>
          <button type="submit" class="btn btn-danger" onclick="return confirmSubmit()">确认导入</button>
          <a href="/admin/database" class="btn btn-cancel">取消</a>
        </div>
      </form>
    </div>
  </main>
  <script>
    function confirmSubmit() {
      var val = document.getElementById('confirm').value.trim();
      if (val !== '确认进行导入') {
        alert('请输入「确认进行导入」以继续');
        return false;
      }
      if (!confirm('即将覆盖当前所有数据，确定要继续吗？')) return false;
      return true;
    }
  </script>
</body>
</html>
