<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>标签管理 - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags" class="active">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/ai">AI 站长</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <h2>标签管理</h2>

    <div class="panel">
      <h3>添加标签</h3>
      <form method="POST" action="/admin/tags" class="inline-form">
        <div class="form-group">
          <label for="name">名称</label>
          <input type="text" id="name" name="name" required placeholder="标签名称">
        </div>
        <div class="form-group">
          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" placeholder="留空自动生成">
        </div>
        <button type="submit" class="btn btn-primary">添加</button>
      </form>
    </div>

    <div class="panel">
      <table>
        <thead>
          <tr>
            <th>名称</th>
            <th>Slug</th>
            <th>文章数</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof tags !== 'undefined' && tags.length > 0) { %>
            <% tags.forEach(function(tag) { %>
            <tr>
              <td><strong><%= tag.name %></strong></td>
              <td><%= tag.slug %></td>
              <td><%= tag.article_count || 0 %></td>
              <td class="actions">
                <a href="/admin/tags/<%= tag.id %>/edit" class="btn btn-primary btn-sm">编辑</a>
                <form method="POST" action="/admin/tags/<%= tag.id %>/delete" style="display:inline" onsubmit="return confirm('确定要删除这个标签吗？')">
                  <button type="submit" class="btn btn-danger btn-sm">删除</button>
                </form>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="4" class="text-muted" style="text-align:center;">暂无标签</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>