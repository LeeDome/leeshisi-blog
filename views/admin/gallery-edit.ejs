<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>编辑图册 - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/galleries" class="active">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/ai">AI 站长</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <h2>编辑图册</h2>

    <div class="panel">
      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <h3>图册信息</h3>
      <form method="POST" action="/admin/galleries/<%= gallery.id %>">
        <div class="form-group">
          <label for="title">标题</label>
          <input type="text" id="title" name="title" value="<%= gallery.title || '' %>" required>
        </div>
        <div class="form-group">
          <label for="description">描述</label>
          <textarea id="description" name="description"><%= gallery.description || '' %></textarea>
        </div>
        <div class="form-group">
          <label>封面图片</label>
          <div class="upload-group">
            <input type="text" id="cover_image" name="cover_image" value="<%= gallery.cover_image || '' %>" placeholder="封面图片地址">
            <button type="button" class="btn btn-upload-image" data-target="cover_image">上传图片</button>
          </div>
          <% if (gallery.cover_image) { %>
            <div class="upload-preview" id="coverPreview"><img src="<%= gallery.cover_image %>" alt="封面预览" style="max-height:80px;"></div>
          <% } else { %>
            <div class="upload-preview" id="coverPreview"></div>
          <% } %>
        </div>
        <div>
          <button type="submit" class="btn btn-primary">保存图册</button>
          <a href="/admin/galleries" class="btn btn-cancel">返回</a>
        </div>
      </form>
    </div>

    <div class="panel">
      <h3>图片列表</h3>
      <table>
        <thead>
          <tr>
            <th>预览</th>
            <th>URL</th>
            <th>描述</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% if (gallery.images && gallery.images.length > 0) { %>
            <% gallery.images.forEach(function(image) { %>
            <tr>
              <td><img src="<%= image.image_url %>" alt="<%= image.caption || '' %>" style="width:80px;height:60px;object-fit:cover;border-radius:4px;"></td>
              <td><%= image.image_url %></td>
              <td><%= image.caption || '-' %></td>
              <td>
                <a href="/admin/galleries/<%= gallery.id %>/images/<%= image.id %>/delete" class="btn btn-danger btn-sm" onclick="return confirm('确定要删除这张图片吗？')">删除</a>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="4" class="text-muted" style="text-align:center;">暂无图片</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="panel">
      <h3>添加图片</h3>
      <form method="POST" action="/admin/galleries/<%= gallery.id %>/images" class="image-add-form">
        <div class="form-group">
          <label>图片</label>
          <div class="upload-group">
            <input type="text" id="image_url" name="image_url" placeholder="图片 URL">
            <button type="button" class="btn btn-upload-image" data-target="image_url">上传图片</button>
          </div>
          <div class="upload-preview" id="imageUrlPreview"></div>
        </div>
        <div class="form-group">
          <label for="caption">描述</label>
          <input type="text" id="caption" name="caption" placeholder="图片描述">
        </div>
        <button type="submit" class="btn btn-primary">添加图片</button>
      </form>
    </div>
  </main>
  <script>
  (function() {
    function triggerUpload(targetId) {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = function(e) {
        var file = e.target.files[0];
        if (!file) return;
        uploadImage(file, targetId);
      };
      input.click();
    }

    function uploadImage(file, targetId) {
      var btn = document.querySelector('[data-target="' + targetId + '"]');
      var originalText = btn.textContent;
      btn.textContent = '上传中...';
      btn.disabled = true;

      var formData = new FormData();
      formData.append('image', file);

      fetch('/admin/upload', {
        method: 'POST',
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) {
          var targetInput = document.getElementById(targetId);
          targetInput.value = data.url;
          if (targetId === 'cover_image') {
            var preview = document.getElementById('coverPreview');
            if (preview) {
              preview.innerHTML = '<img src="' + data.url + '" alt="封面预览" style="max-height:80px;">';
            }
          }
          if (targetId === 'image_url') {
            var preview = document.getElementById('imageUrlPreview');
            if (preview) {
              preview.innerHTML = '<img src="' + data.url + '" alt="图片预览" style="max-height:80px;">';
            }
          }
        } else {
          alert('上传失败: ' + data.message);
        }
      })
      .catch(function(err) {
        alert('上传失败: ' + (err.message || '网络错误'));
      })
      .finally(function() {
        btn.textContent = originalText;
        btn.disabled = false;
      });
    }

    document.querySelectorAll('.btn-upload-image').forEach(function(btn) {
      btn.addEventListener('click', function() {
        triggerUpload(this.dataset.target);
      });
    });
  })();
  </script>
</body>
</html>