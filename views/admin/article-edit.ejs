<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article ? '编辑文章' : '新建文章' %> - 管理后台</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/lib/highlight/styles/github-dark-dimmed.min.css">
  <style>
    .md-editor-wrap { border: 1px solid #ddd; border-radius: 6px; overflow: hidden; }
    .md-editor-toolbar {
      display: flex; flex-wrap: wrap; gap: 2px; padding: 6px 8px;
      background: #f8f9fa; border-bottom: 1px solid #ddd;
    }
    .md-editor-toolbar button {
      background: #fff; border: 1px solid #ccc; border-radius: 3px;
      padding: 4px 10px; cursor: pointer; font-size: 13px; color: #333;
      transition: background 0.15s;
    }
    .md-editor-toolbar button:hover { background: #e9ecef; }
    .md-editor-toolbar .sep { width: 1px; background: #ddd; margin: 0 4px; }
    .md-editor-body { display: flex; min-height: 500px; }
    .md-editor-body textarea {
      flex: 1; border: none; resize: none; padding: 16px;
      font-family: "SF Mono", "Fira Code", "Courier New", monospace;
      font-size: 14px; line-height: 1.6; outline: none; tab-size: 2;
    }
    .md-preview {
      flex: 1; padding: 16px 20px; overflow-y: auto;
      border-left: 1px solid #ddd; background: #fff;
      line-height: 1.8; font-size: 15px;
    }
    .md-preview h1,.md-preview h2,.md-preview h3,.md-preview h4,.md-preview h5,.md-preview h6 { margin-top: 1.2em; margin-bottom: 0.5em; font-weight: 600; }
    .md-preview h2 { border-bottom: 1px solid #eee; padding-bottom: 4px; }
    .md-preview p { margin-bottom: 0.8em; }
    .md-preview a { color: #0366d6; text-decoration: underline; }
    .md-preview img { max-width: 100%; border-radius: 4px; }
    .md-preview pre {
      background: #1c1e22; padding: 14px 18px; border-radius: 6px;
      overflow-x: auto; font-size: 13px; line-height: 1.5; margin: 12px 0;
      border: 1px solid #2a2c32; position: relative;
    }
    .md-preview code {
      font-family: "SF Mono", "Fira Code", "Courier New", monospace; font-size: 0.9em;
    }
    .md-preview :not(pre) > code {
      background: #f0f0f0; padding: 2px 6px; border-radius: 3px; color: #d63384;
    }
    .md-preview blockquote {
      border-left: 3px solid #0366d6; padding: 8px 16px; color: #666;
      background: #f6f8fa; border-radius: 0 4px 4px 0; margin: 12px 0;
    }
    .md-preview ul, .md-preview ol { padding-left: 24px; margin: 8px 0; }
    .md-preview table { border-collapse: collapse; width: 100%; margin: 12px 0; }
    .md-preview th, .md-preview td { border: 1px solid #ddd; padding: 6px 12px; text-align: left; }
    .md-preview th { background: #f6f8fa; font-weight: 600; }
    .md-preview hr { border: none; border-top: 1px solid #eee; margin: 16px 0; }
    .md-preview .mermaid {
      background: #fafafa; border-radius: 6px; padding: 16px;
      text-align: center; margin: 12px 0;
    }
    .md-preview .mermaid svg { max-width: 100%; height: auto; }
    /* AI 润色模态框 */
    .modal-overlay {
      display: none; position: fixed; z-index: 1000; left: 0; top: 0;
      width: 100%; height: 100%; background: rgba(0,0,0,0.5);
      align-items: center; justify-content: center;
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
      background: #fff; border-radius: 10px; width: 80%; max-width: 900px;
      max-height: 80vh; display: flex; flex-direction: column;
      box-shadow: 0 8px 30px rgba(0,0,0,0.2);
    }
    .modal-header {
      padding: 16px 24px; border-bottom: 1px solid #eee;
      font-size: 16px; font-weight: 600; display: flex;
      justify-content: space-between; align-items: center;
    }
    .modal-close {
      background: none; border: none; font-size: 20px;
      cursor: pointer; color: #999; padding: 0 4px;
    }
    .modal-close:hover { color: #333; }
    .modal-body {
      flex: 1; overflow-y: auto; padding: 20px 24px;
      display: flex; gap: 20px;
    }
    .modal-body .diff-panel {
      flex: 1; min-width: 0;
    }
    .modal-body .diff-panel h4 {
      margin: 0 0 8px 0; font-size: 14px; color: #666;
    }
    .modal-body .diff-panel .diff-content {
      border: 1px solid #ddd; border-radius: 6px; padding: 12px;
      font-size: 14px; line-height: 1.6; min-height: 200px;
      white-space: pre-wrap; word-wrap: break-word;
      max-height: 50vh; overflow-y: auto;
    }
    .modal-body .diff-panel .diff-content.original {
      background: #fafafa;
    }
    .modal-body .diff-panel .diff-content.polished {
      background: #f0fdf4;
    }
    .modal-footer {
      padding: 12px 24px; border-top: 1px solid #eee;
      display: flex; gap: 10px; justify-content: flex-end;
    }
    .ai-loading {
      display: inline-flex; align-items: center; gap: 6px;
      color: #1976d2; font-size: 13px;
    }
    .ai-loading .spinner {
      width: 14px; height: 14px; border: 2px solid #e0e0e0;
      border-top-color: #1976d2; border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    /* 图片库模态框 */
    .image-lib-upload {
      margin-bottom: 16px; padding: 14px; border: 1px dashed #ccc;
      border-radius: 8px; background: #fafafa; text-align: center;
    }
    .image-lib-upload .hint { color: #999; font-size: 12px; margin-top: 6px; }
    .image-lib-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 12px; max-height: 45vh; overflow-y: auto;
    }
    .image-lib-item {
      border: 1px solid #e0e0e0; border-radius: 6px; overflow: hidden;
      cursor: pointer; background: #fff; position: relative;
      transition: box-shadow 0.15s, border-color 0.15s;
    }
    .image-lib-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.12); border-color: #1976d2; }
    .image-lib-item.selected { border-color: #1976d2; box-shadow: 0 0 0 2px rgba(25,118,210,0.25); }
    .image-lib-item img {
      width: 100%; height: 90px; object-fit: cover; display: block;
      background: #f0f0f0;
    }
    .image-lib-item .name {
      font-size: 11px; color: #666; padding: 3px 6px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .image-lib-item .mask {
      position: absolute; top: 0; left: 0; right: 0;
      background: rgba(25,118,210,0.9); color: #fff;
      font-size: 12px; text-align: center; padding: 4px 0;
      display: none;
    }
    .image-lib-item.selected .mask { display: block; }
    .image-lib-empty { color: #999; text-align: center; padding: 40px 0; }
    .image-lib-loading { color: #1976d2; text-align: center; padding: 40px 0; }
  </style>
</head>
<body>
  <aside class="admin-sidebar">
    <div class="logo">博客后台</div>
    <nav>
      <a href="/admin">仪表盘</a>
      <a href="/admin/articles" class="active">文章管理</a>
      <a href="/admin/categories">分类管理</a>
      <a href="/admin/tags">标签管理</a>
      <a href="/admin/galleries">图册管理</a>
      <a href="/admin/comments">评论管理</a>
      <a href="/admin/pages">页面管理</a>
      <a href="/admin/settings">站点设置</a>
      <a href="/admin/account">账号设置</a>
      <a href="/admin/ai">AI 站长</a>
      <a href="/admin/database">数据库管理</a>
      <a href="/admin/logout" class="logout-link">退出</a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if (locals.messages && messages.length > 0) { %>
      <% messages.forEach(function(msg) { %>
        <div class="alert <%= msg.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
      <% }); %>
    <% } %>

    <h2><%= article && article.id ? '编辑文章' : '新建文章' %></h2>

    <div class="panel">
      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="<%= article && article.id ? '/admin/articles/' + article.id : '/admin/articles' %>" id="articleForm">
        <div class="form-group">
          <label for="title">标题</label>
          <input type="text" id="title" name="title" value="<%= article ? article.title || '' : '' %>" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="slug">Slug</label>
            <input type="text" id="slug" name="slug" value="<%= article ? article.slug || '' : '' %>">
            <span class="help-text">留空则自动从标题生成</span>
          </div>
          <div class="form-group">
            <label for="category_id">分类</label>
            <select id="category_id" name="category_id">
              <option value="">-- 请选择 --</option>
              <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat.id %>" <%= article && article.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="excerpt">摘要</label>
          <textarea id="excerpt" name="excerpt" rows="3"><%= article ? article.excerpt || '' : '' %></textarea>
        </div>
        <div class="form-group">
          <label>封面图片</label>
          <div class="upload-group">
            <input type="text" id="cover_image" name="cover_image" value="<%= article ? article.cover_image || '' : '' %>" placeholder="封面图片 URL">
            <button type="button" class="btn btn-upload-image" data-target="cover_image">上传图片</button>
          </div>
          <% if (article && article.cover_image) { %>
            <div class="upload-preview" id="coverPreview"><img src="<%= article.cover_image %>" alt="封面预览" style="max-height:80px;"></div>
          <% } else { %>
            <div class="upload-preview" id="coverPreview"></div>
          <% } %>
        </div>
        <div class="form-group">
          <label>内容 (Markdown)</label>
          <div class="md-editor-wrap">
            <div class="md-editor-toolbar">
              <button type="button" data-action="h2" title="二级标题">H2</button>
              <button type="button" data-action="h3" title="三级标题">H3</button>
              <div class="sep"></div>
              <button type="button" data-action="bold" title="加粗"><b>B</b></button>
              <button type="button" data-action="italic" title="斜体"><i>I</i></button>
              <button type="button" data-action="strike" title="删除线"><s>S</s></button>
              <div class="sep"></div>
              <button type="button" data-action="code" title="行内代码">&lt;code&gt;</button>
              <button type="button" data-action="codeblock" title="代码块">{ }</button>
              <div class="sep"></div>
              <button type="button" data-action="link" title="链接">Link</button>
              <button type="button" data-action="image" title="图片">Img</button>
              <button type="button" data-action="image-library" title="插入图片库图片">图片库</button>
              <button type="button" data-action="quote" title="引用">&gt;</button>
              <div class="sep"></div>
              <button type="button" data-action="ul" title="无序列表">UL</button>
              <button type="button" data-action="ol" title="有序列表">OL</button>
              <button type="button" data-action="table" title="表格">Table</button>
              <button type="button" data-action="hr" title="分隔线">HR</button>
              <div class="sep"></div>
              <button type="button" data-action="ai-polish" title="AI润色">AI 润色</button>
            </div>
            <div class="md-editor-body">
              <textarea id="content" name="content" required><%= article ? article.content || '' : '' %></textarea>
              <div class="md-preview" id="mdPreview"></div>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>标签</label>
          <div class="tag-checkboxes">
            <% if (typeof tags !== 'undefined' && tags.length > 0) { %>
              <% tags.forEach(function(tag) { %>
                <label>
                  <input type="checkbox" name="tag_ids" value="<%= tag.id %>" <%= selectedTags && selectedTags.indexOf(tag.id) !== -1 ? 'checked' : '' %>>
                  <%= tag.name %>
                </label>
              <% }); %>
            <% } else { %>
              <span class="help-text">暂无标签</span>
            <% } %>
          </div>
        </div>
        <div class="form-group">
          <label>状态</label>
          <div class="radio-group">
            <label>
              <input type="radio" name="status" value="published" <%= article && article.status === 'published' ? 'checked' : (!article ? 'checked' : '') %>>
              发布
            </label>
            <label>
              <input type="radio" name="status" value="draft" <%= article && article.status === 'draft' ? 'checked' : '' %>>
              草稿
            </label>
          </div>
        </div>
        <div>
          <button type="submit" class="btn btn-primary">保存</button>
          <a href="/admin/articles" class="btn btn-cancel">取消</a>
        </div>
      </form>
    </div>
  </main>

  <script src="/lib/marked/marked.min.js"></script>
  <script src="/lib/highlight/highlight.min.js"></script>
  <script>
  // 兼容性 polyfill：旧浏览器不支持 Object.hasOwn（ES2022）
  if (!Object.hasOwn) {
    Object.hasOwn = function(obj, prop) {
      return Object.prototype.hasOwnProperty.call(obj, prop);
    };
  }
  </script>
  <script src="/lib/mermaid/mermaid.min.js"></script>
  <script>
  (function() {
    var textarea = document.getElementById('content');
    var preview = document.getElementById('mdPreview');
    var renderTimer = null;

    marked.setOptions({
      highlight: function(code, lang) {
        if (lang && hljs.getLanguage(lang)) {
          try { return hljs.highlight(code, { language: lang }).value; } catch(_) {}
        }
        return hljs.highlightAuto(code).value;
      },
      gfm: true,
      breaks: true
    });

    // Mermaid 图表渲染（与客户端保持一致）
    function renderMermaid() {
      var pres = preview.querySelectorAll('pre');
      var nodes = [];
      pres.forEach(function(pre) {
        var code = pre.querySelector('code');
        var text = code ? (code.textContent || code.innerText) : pre.textContent;
        text = text.trim();
        if (!text) return;

        var mText = null;
        if (/^(graph |flowchart |sequenceDiagram|classDiagram|erDiagram|gantt )/.test(text)) {
          mText = text;
        }
        if (text.indexOf('pie showData') === 0) {
          mText = text.replace(/^pie showData\s*\n\s*title\s+/, 'pie title ');
        }

        if (mText) {
          var div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = mText;
          pre.parentNode.replaceChild(div, pre);
          nodes.push(div);
        }
      });
      if (nodes.length && window.mermaid) {
        try {
          mermaid.initialize({
            startOnLoad: false,
            theme: 'default',
            themeVariables: {
              primaryColor: '#e5e7eb',
              primaryTextColor: '#2a2c32',
              primaryBorderColor: '#9ca3af',
              lineColor: '#6b7280',
              secondaryColor: '#f3f4f6',
              tertiaryColor: '#f9fafb'
            }
          });
          mermaid.run({ nodes: nodes }).catch(function(e) { console.warn('Mermaid 渲染失败:', e); });
        } catch (e) { console.warn('Mermaid 渲染失败:', e); }
      }
    }

    function updatePreview() {
      preview.innerHTML = marked.parse(textarea.value);
      renderMermaid();
    }

    textarea.addEventListener('input', function() {
      clearTimeout(renderTimer);
      renderTimer = setTimeout(updatePreview, 300);
    });
    updatePreview();

    // Tab 键支持
    textarea.addEventListener('keydown', function(e) {
      if (e.key === 'Tab') {
        e.preventDefault();
        var start = this.selectionStart;
        var end = this.selectionEnd;
        this.value = this.value.substring(0, start) + '  ' + this.value.substring(end);
        this.selectionStart = this.selectionEnd = start + 2;
        updatePreview();
      }
    });

    // 工具栏操作
    document.querySelectorAll('.md-editor-toolbar button[data-action]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var action = this.dataset.action;

        if (action === 'image-library') {
          openImageLibrary();
          return;
        }

        var start = textarea.selectionStart;
        var end = textarea.selectionEnd;
        var sel = textarea.value.substring(start, end);
        var before = '', after = '', newCursorPos = start;

        switch(action) {
          case 'h2': before = '## '; after = ''; break;
          case 'h3': before = '### '; after = ''; break;
          case 'bold': before = '**'; after = '**'; break;
          case 'italic': before = '*'; after = '*'; break;
          case 'strike': before = '~~'; after = '~~'; break;
          case 'code': before = '`'; after = '`'; break;
          case 'codeblock': before = '```js\n'; after = '\n```'; break;
          case 'link': before = '['; after = '](url)'; break;
          case 'image': before = '!['; after = '](url)'; break;
          case 'quote': before = '> '; after = ''; break;
          case 'ul': before = '- '; after = ''; break;
          case 'ol': before = '1. '; after = ''; break;
          case 'table': before = '| 列1 | 列2 | 列3 |\n| --- | --- | --- |\n| '; after = ' | | |'; break;
          case 'hr': before = '\n---\n'; after = ''; break;
        }

        var replacement = before + sel + after;
        textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
        textarea.selectionStart = textarea.selectionEnd = start + before.length + sel.length;
        textarea.focus();
        updatePreview();
      });
    });
  })();
  </script>
  <script>
  (function() {
    function triggerUpload(targetId) {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = function(e) {
        var file = e.target.files[0];
        if (!file) return;
        uploadImage(file, targetId);
      };
      input.click();
    }

    function uploadImage(file, targetId) {
      var btn = document.querySelector('[data-target="' + targetId + '"]');
      var originalText = btn.textContent;
      btn.textContent = '上传中...';
      btn.disabled = true;

      var formData = new FormData();
      formData.append('image', file);

      fetch('/admin/upload', {
        method: 'POST',
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) {
          var targetInput = document.getElementById(targetId);
          targetInput.value = data.url;
          if (targetId === 'cover_image') {
            var preview = document.getElementById('coverPreview');
            preview.innerHTML = '<img src="' + data.url + '" alt="封面预览" style="max-height:80px;">';
          }
        } else {
          alert('上传失败: ' + data.message);
        }
      })
      .catch(function(err) {
        alert('上传失败: ' + (err.message || '网络错误'));
      })
      .finally(function() {
        btn.textContent = originalText;
        btn.disabled = false;
      });
    }

    document.querySelectorAll('.btn-upload-image').forEach(function(btn) {
      btn.addEventListener('click', function() {
        triggerUpload(this.dataset.target);
      });
    });
  })();
  </script>

  <!-- AI 润色模态框 -->
  <div class="modal-overlay" id="aiPolishModal">
    <div class="modal-box">
      <div class="modal-header">
        <span>AI 润色结果</span>
        <button type="button" class="modal-close" onclick="closePolishModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="diff-panel">
          <h4>原文</h4>
          <div class="diff-content original" id="originalContent"></div>
        </div>
        <div class="diff-panel">
          <h4>润色后</h4>
          <div class="diff-content polished" id="polishedContent"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" onclick="closePolishModal()">取消</button>
        <button type="button" class="btn btn-primary" id="confirmPolishBtn" onclick="confirmPolish()">确认替换</button>
      </div>
    </div>
  </div>

  <script>
  (function() {
    var textarea = document.getElementById('content');

    // AI 润色按钮事件
    document.querySelector('button[data-action="ai-polish"]').addEventListener('click', function() {
      var content = textarea.value;
      if (!content || !content.trim()) {
        alert('请先输入文章内容再进行润色');
        return;
      }

      var btn = this;
      var originalText = btn.textContent;
      btn.innerHTML = '<span class="ai-loading"><span class="spinner"></span>AI 润色中...</span>';
      btn.disabled = true;

      fetch('/admin/ai/polish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content, style: 'polish' })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) {
          document.getElementById('originalContent').textContent = content;
          document.getElementById('polishedContent').textContent = data.result;
          document.getElementById('aiPolishModal').classList.add('active');
        } else {
          alert('润色失败: ' + (data.message || '未知错误'));
        }
      })
      .catch(function(err) {
        alert('请求失败: ' + (err.message || '网络错误'));
      })
      .finally(function() {
        btn.innerHTML = originalText;
        btn.disabled = false;
      });
    });
  })();

  function closePolishModal() {
    document.getElementById('aiPolishModal').classList.remove('active');
  }

  function confirmPolish() {
    var polished = document.getElementById('polishedContent').textContent;
    document.getElementById('content').value = polished;
    // 触发预览更新
    var evt = new Event('input');
    document.getElementById('content').dispatchEvent(evt);
    closePolishModal();
  }

  // 点击遮罩层关闭
  document.getElementById('aiPolishModal').addEventListener('click', function(e) {
    if (e.target === this) closePolishModal();
  });
  </script>

  <!-- 图片库模态框 -->
  <div class="modal-overlay" id="imageLibModal">
    <div class="modal-box" style="max-width:640px;">
      <div class="modal-header">
        <span>图片库</span>
        <button type="button" class="modal-close" onclick="closeImageLibrary()">&times;</button>
      </div>
      <div class="modal-body" style="flex-direction:column;">
        <div class="image-lib-upload">
          <button type="button" class="btn btn-primary" id="imageLibUploadBtn">上传图片</button>
          <div class="hint">支持 jpg / png / gif / webp / svg / bmp，单张不超过 10MB；上传后点击图片即可插入</div>
        </div>
        <div id="imageLibGrid" class="image-lib-grid">
          <div class="image-lib-loading">加载中...</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" onclick="closeImageLibrary()">取消</button>
        <button type="button" class="btn btn-primary" id="imageLibInsertBtn" disabled>插入图片</button>
      </div>
    </div>
  </div>

  <script>
  (function() {
    var libTextarea = document.getElementById('content');
    var libGrid = document.getElementById('imageLibGrid');
    var libInsertBtn = document.getElementById('imageLibInsertBtn');
    var selectedUrl = null;

    window.closeImageLibrary = function() {
      document.getElementById('imageLibModal').classList.remove('active');
    };

    window.selectImageLibraryImage = function(url) {
      selectedUrl = url;
      libGrid.querySelectorAll('.image-lib-item').forEach(function(el) {
        el.classList.toggle('selected', el.dataset.url === url);
      });
      libInsertBtn.disabled = !url;
    };

    // 打开图片库并加载列表
    window.openImageLibrary = function() {
      document.getElementById('imageLibModal').classList.add('active');
      loadImageLibrary();
    };

    function loadImageLibrary() {
      libGrid.innerHTML = '<div class="image-lib-loading">加载中...</div>';
      selectedUrl = null;
      libInsertBtn.disabled = true;
      return fetch('/admin/images')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.success) { throw new Error(data.message || '加载失败'); }
          renderImageGrid(data.images || []);
        })
        .catch(function(err) {
          libGrid.innerHTML = '<div class="image-lib-empty">加载失败: ' + (err.message || '网络错误') + '</div>';
        });
    }

    function renderImageGrid(images) {
      if (!images.length) {
        libGrid.innerHTML = '<div class="image-lib-empty">暂无图片，请先上传</div>';
        return;
      }
      libGrid.innerHTML = '';
      images.forEach(function(img) {
        var item = document.createElement('div');
        item.className = 'image-lib-item';
        item.dataset.url = img.url;
        item.innerHTML = '<div class="mask">已选择</div>'
          + '<img src="' + img.url + '" alt="' + (img.name || '') + '" loading="lazy" style="' + (isSvg(img.url) ? 'object-fit:contain;' : '') + '">'
          + '<div class="name">' + (img.name || '') + '</div>';
        item.addEventListener('click', function() {
          selectImageLibraryImage(img.url);
        });
        libGrid.appendChild(item);
      });
    }

    function isSvg(url) { return /\.svg$/i.test(url); }

    libInsertBtn.addEventListener('click', function() {
      if (!selectedUrl) return;
      insertMarkdown(selectedUrl);
    });

    // 在光标处插入 markdown 图片
    function insertMarkdown(url) {
      var md = '![' + fileBaseName(url) + '](' + url + ')';
      var start = libTextarea.selectionStart;
      var end = libTextarea.selectionEnd;
      libTextarea.value = libTextarea.value.substring(0, start) + md + libTextarea.value.substring(end);
      var caret = start + md.length;
      libTextarea.selectionStart = libTextarea.selectionEnd = caret;
      libTextarea.focus();
      libTextarea.dispatchEvent(new Event('input'));
      closeImageLibrary();
    }

    function fileBaseName(url) {
      var clean = url.split('?')[0];
      var parts = clean.split('/');
      return parts[parts.length - 1];
    }

    // 上传图片
    document.getElementById('imageLibUploadBtn').addEventListener('click', function() {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = function(e) {
        var file = e.target.files[0];
        if (!file) return;
        uploadLibraryImage(file);
      };
      input.click();
    });

    function uploadLibraryImage(file) {
      var btn = document.getElementById('imageLibUploadBtn');
      var originalText = btn.textContent;
      btn.textContent = '上传中...';
      btn.disabled = true;

      var formData = new FormData();
      formData.append('image', file);

      fetch('/admin/upload', {
        method: 'POST',
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) {
          // 上传成功，刷新图片列表并选中新图片
          loadImageLibrary().then(function() {
            var items = libGrid.querySelectorAll('.image-lib-item');
            items.forEach(function(el) {
              if (el.dataset.url === data.url) selectImageLibraryImage(data.url);
            });
          });
        } else {
          alert('上传失败: ' + data.message);
        }
      })
      .catch(function(err) {
        alert('上传失败: ' + (err.message || '网络错误'));
      })
      .finally(function() {
        btn.textContent = originalText;
        btn.disabled = false;
      });
    }

    // 点击遮罩层关闭
    document.getElementById('imageLibModal').addEventListener('click', function(e) {
      if (e.target === this) closeImageLibrary();
    });
  })();
  </script>
</body>
</html>
