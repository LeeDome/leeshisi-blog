<% if (locals.article) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.excerpt || '',
  "image": (typeof absoluteUrl === 'function') ? absoluteUrl(article.cover_image || '') : (article.cover_image || ''),
  "datePublished": article.created_at,
  "dateModified": article.updated_at || article.created_at,
  "author": { "@type": "Person", "name": (article.author && article.author.nickname) || '' },
  "mainEntityOfPage": { "@type": "WebPage", "@id": (typeof canonical !== 'undefined' ? canonical : '') }
}).replace(/</g, '\\u003c') %>
</script>
<article class="article-detail">
  <div class="back-nav"><a href="javascript:history.back()" class="back-link">&laquo; 返回上一页</a></div>
  <header class="article-header">
    <h1 class="article-title"><%= article.title %></h1>
    <div class="article-meta">
      <span class="meta-item">
        <svg class="meta-icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
        <%= article.created_at %>
      </span>
      <span class="meta-item">
        <svg class="meta-icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
        <%= article.view_count || 0 %>
      </span>
      <button type="button" class="meta-like-btn" data-article-id="<%= article.id %>" aria-label="点赞">
        <svg class="meta-icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span class="like-label">点赞</span>
        <span class="like-count"><%= article.like_count || 0 %></span>
      </button>
      <span class="meta-item">
        <svg class="meta-icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        <%= article.comment_count || 0 %>
      </span>
      <% if (article.author && article.author.nickname) { %>
      <span class="meta-item meta-author"><%= article.author.nickname %></span>
      <% } %>
    </div>

    <% if (locals.tags && tags.length > 0) { %>
    <div class="article-tags">
      <% tags.forEach(function(tag) { %>
      <a href="/tag/<%= tag.id %>" class="article-tag">#<%= tag.name %></a>
      <% }); %>
    </div>
    <% } %>
  </header>

  <div class="rating-section">
    <span class="rating-label">评分：</span>
    <span class="rating-score"><%= Math.round((article.rating_score || 0) * 100) / 100 %></span>
    <div class="rating-stars" data-article-id="<%= article.id %>">
      <% for (var i = 1; i <= 5; i++) { %>
        <button class="rating-star <%= i <= Math.round(article.rating_score || 0) ? 'active' : '' %>" data-value="<%= i %>" aria-label="<%= i %>星">&#9733;</button>
      <% } %>
    </div>
  </div>

  <div class="article-content" id="articleContent">
    <%- article.content %>
  </div>
</article>

<div class="comments-section" id="comments">
  <% if (locals.comment_submitted) { %>
  <div class="comment-success">评论提交成功，审核后将会显示</div>
  <% } %>
  <div class="comments-header">
    <h3 class="comments-title">评论 (<%= commentTotal || 0 %>)</h3>
    <div class="comments-sort">
      <a href="?commentSort=newest#comments" class="sort-link <%= (!locals.commentSort || commentSort === 'newest') ? 'active' : '' %>">最新</a>
      <a href="?commentSort=hottest#comments" class="sort-link <%= commentSort === 'hottest' ? 'active' : '' %>">最热</a>
    </div>
  </div>

  <div class="comment-form-wrap">
    <h4 class="comment-form-title">发表评论</h4>
    <form class="comment-form" action="/comment" method="POST">
      <input type="hidden" name="article_id" value="<%= article.id %>">
      <input type="hidden" name="page_type" value="article">
      <div class="comment-form-row">
        <input type="email" name="email" class="comment-input" placeholder="邮箱 *" required>
        <input type="text" name="nickname" class="comment-input" placeholder="昵称 *" required>
        <input type="url" name="website" class="comment-input" placeholder="网站（可选）">
      </div>
      <textarea name="content" class="comment-textarea" placeholder="写下你的评论..." required></textarea>
      <button type="submit" class="comment-submit-btn">提交评论</button>
    </form>
  </div>

  <% if (locals.comments && comments.length > 0) { %>
  <ul class="comment-list">
    <% comments.forEach(function(comment) { %>
      <%- include('_comment-item', { comment: comment, article: article, votedCommentMap: votedCommentMap, gravatar: gravatar }) %>
    <% }); %>
  </ul>

  <% if (locals.commentTotalPages && commentTotalPages > 1) { %>
  <div class="load-more-comments-wrap">
    <button type="button" class="load-more-comments-btn" data-next-page="<%= commentPage + 1 %>" data-loaded="false">加载更多评论</button>
  </div>
  <% } %>

  <% } else { %>
  <div class="empty-state">
    <p>暂无评论，快来抢沙发吧！</p>
  </div>
  <% } %>
</div>

<!-- Toast 通知 -->
<div id="toast" class="toast"></div>

<script>
(function() {
  // ========== Toast 通知 ==========
  function showToast(msg) {
    var toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.add('toast-show');
    clearTimeout(toast._timeout);
    toast._timeout = setTimeout(function() {
      toast.classList.remove('toast-show');
    }, 2000);
  }

  // 代码块复制按钮
  document.querySelectorAll('.article-content pre').forEach(function(pre) {
    var btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.textContent = '复制';
    btn.addEventListener('click', function() {
      var code = pre.querySelector('code');
      var text = code ? code.textContent : pre.textContent;
      navigator.clipboard.writeText(text).then(function() {
        btn.textContent = '已复制';
        btn.classList.add('copied');
        setTimeout(function() {
          btn.textContent = '复制';
          btn.classList.remove('copied');
        }, 2000);
      });
    });
    pre.appendChild(btn);
  });

  // ========== 文章评分 ==========
  var ratingStars = document.querySelectorAll('.rating-star');
  var ratingSection = document.querySelector('.rating-stars');
  var articleId = ratingSection ? ratingSection.dataset.articleId : null;

  ratingStars.forEach(function(star) {
    star.addEventListener('click', function() {
      if (!articleId) {
        console.log('[rating] articleId 为空，跳过');
        return;
      }
      var value = parseInt(this.dataset.value);
      console.log('[rating] 点击评分:', articleId, value);
      fetch('/article/rate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ article_id: articleId, score: value })
      }).then(function(res) { return res.json(); })
        .then(function(data) {
          console.log('[rating] 响应:', data);
          if (data.success) {
            ratingStars.forEach(function(s, idx) {
              s.classList.toggle('active', idx < value);
            });
            var scoreEl = document.querySelector('.rating-score');
            if (scoreEl) scoreEl.textContent = Math.round(data.rating_score * 100) / 100;
            showToast('评分成功');
          } else {
            showToast(data.message || '评分失败');
          }
        })
        .catch(function() {
          showToast('网络错误');
        });
    });
  });

  // ========== 文章点赞 ==========
  var likeBtn = document.querySelector('.meta-like-btn');
  if (likeBtn) {
    likeBtn.addEventListener('click', function() {
      var aid = this.dataset.articleId;
      fetch('/article/like', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ article_id: aid })
      }).then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            var countSpan = likeBtn.querySelector('.like-count');
            if (countSpan) countSpan.textContent = data.like_count;
            likeBtn.classList.add('active');
            showToast('点赞成功');
          } else {
            showToast(data.message || '点赞失败');
          }
        })
        .catch(function() {
          showToast('网络错误');
        });
    });
  }

  // ========== 评论投票状态本地缓存 ==========
  var votedComments = <%- typeof votedCommentMap !== 'undefined' ? JSON.stringify(votedCommentMap) : '{}'%>;
  function getVoteKey(commentId, type) {
    return 'cv_' + commentId + '_' + type;
  }
  function setVote(commentId, type) {
    localStorage.setItem(getVoteKey(commentId, type), '1');
  }
  function hasVote(commentId, type) {
    return localStorage.getItem(getVoteKey(commentId, type)) === '1' || votedComments[commentId] === type;
  }

  // 初始化按钮 active 状态（服务端投票状态）
  document.querySelectorAll('.comment-like-btn').forEach(function(btn) {
    var id = btn.dataset.commentId;
    if (votedComments[id] === 'like') btn.classList.add('active');
  });
  document.querySelectorAll('.comment-dislike-btn').forEach(function(btn) {
    var id = btn.dataset.commentId;
    if (votedComments[id] === 'dislike') btn.classList.add('active');
  });

  // 管理员昵称（受保护，不允许评论者使用相同昵称），页面加载时获取
  var PROTECTED_NICKNAME = <%- JSON.stringify(author && author.nickname ? author.nickname : '') %>;

  // 后端返回的昵称冲突错误提示
  <% if (locals.comment_error === 'protected_nickname') { %>
  if (typeof showToast === 'function') showToast('该昵称与博主昵称重合，请更换昵称');
  <% } %>

  // 评论频率限制 / IP 拉黑提示
  <% if (locals.comment_error === 'too_frequent') { %>
  if (typeof showToast === 'function') showToast('发言频繁，请稍后再试');
  <% } %>
  <% if (locals.comment_error === 'blacklisted') { %>
  if (typeof showToast === 'function') showToast('发言过于频繁，已被暂时限制，请稍后重试');
  <% } %>

  // 校验昵称不与管理员昵称重合
  function guardNickname(input) {
    var val = (input.value || '').trim();
    var form = input.closest('form');
    if (!form) return;
    if (val && PROTECTED_NICKNAME && (val === PROTECTED_NICKNAME || val.toLowerCase() === String(PROTECTED_NICKNAME).toLowerCase())) {
      input.setCustomValidity && input.setCustomValidity('该昵称已被占用，请更换');
      showToast && showToast('该昵称与博主昵称重合，请更换昵称');
      form.dataset.guarded = '1';
    } else {
      input.setCustomValidity && input.setCustomValidity('');
      if (form) form.dataset.guarded = '';
    }
  }

  // ========== 评论身份缓存：提交后自动记住邮箱/昵称/网站，下次自动填充 ==========
  var COMMENT_CACHE_KEY = 'comment_identity_cache';

  function saveCommentCache(form) {
    try {
      var email = (form.querySelector('[name="email"]') || {}).value || '';
      var nickname = (form.querySelector('[name="nickname"]') || {}).value || '';
      var website = (form.querySelector('[name="website"]') || {}).value || '';
      // 仅缓存填写了邮箱+昵称、或填了网站的身份信息
      if (!email && !nickname && !website) return;
      localStorage.setItem(COMMENT_CACHE_KEY, JSON.stringify({ email: email, nickname: nickname, website: website }));
    } catch (e) {}
  }

  function loadCommentCache() {
    try {
      var raw = localStorage.getItem(COMMENT_CACHE_KEY);
      if (!raw) return;
      var data = JSON.parse(raw) || {};
      document.querySelectorAll('form[action="/comment"]').forEach(function(form) {
        var email = form.querySelector('[name="email"]');
        var nickname = form.querySelector('[name="nickname"]');
        var website = form.querySelector('[name="website"]');
        if (email && data.email) email.value = data.email;
        if (nickname && data.nickname) nickname.value = data.nickname;
        if (website && typeof data.website === 'string') website.value = data.website;
      });
    } catch (e) {}
  }

  // 评论交互事件统一绑定（支持对动态加载的评论局部重新绑定）
  function bindCommentActions(scope) {
    // 昵称保护：输入完成后即时校验
    scope.querySelectorAll('.comment-input[name="nickname"]').forEach(function(input) {
      input.addEventListener('input', function() { guardNickname(this); });
      input.addEventListener('blur', function() { guardNickname(this); });
    });
    scope.querySelectorAll('form.comment-form, form[action="/comment"]').forEach(function(form) {
      form.addEventListener('submit', function(ev) {
        var n = form.querySelector('input[name="nickname"]');
        if (n && form.dataset.guarded === '1') {
          ev.preventDefault();
          showToast && showToast('该昵称与博主昵称重合，请更换昵称');
          return;
        }
        // 局部刷新：AJAX 提交评论，成功后把新评论插入评论区，不清空整页
        ev.preventDefault();
        var btn = form.querySelector('.comment-submit-btn');
        if (btn) btn.disabled = true;

        var body = new URLSearchParams(new FormData(form)).toString();
        fetch('/comment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: body
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (btn) btn.disabled = false;
            if (data.success) {
              saveCommentCache(form);
              var textarea = form.querySelector('textarea[name="content"]');
              if (textarea) textarea.value = '';
              var wrap = document.createElement('div');
              wrap.innerHTML = data.html;
              var node = wrap.children[0];
              if (!node) { if (showToast) showToast('评论已提交'); return; }

              if (data.parentId) {
                // 子回复：追加到父评论的 children 容器
                var children = document.getElementById('comment-children-' + data.parentId);
                if (children) { children.appendChild(node); }
                else { var replyForm = document.getElementById('reply-form-' + data.parentId); if (replyForm && replyForm.parentNode) replyForm.parentNode.insertBefore(node, replyForm.nextSibling); }
              } else {
                // 顶级评论：插入到列表头部
                var list = document.getElementById('comments');
                var ul = list.querySelector('.comment-list');
                if (ul) { ul.insertBefore(node, ul.firstChild); }
                else { var empty = list.querySelector('.empty-state'); if (empty) empty.remove(); ul = document.createElement('ul'); ul.className = 'comment-list'; list.insertBefore(ul, list.querySelector('.comment-form-wrap')); ul.appendChild(node); }
              }
              // 更新评论数
              var title = document.querySelector('.comments-title');
              if (title) {
                var m = /[（(]?\s*(\d+)\s*[）)]?/.exec(title.textContent);
                var cur = m ? parseInt(m[1]) : 0;
                title.textContent = title.textContent.replace(/\d+/, cur + 1);
              }
              // 重新绑定动态插入的元素事件、渲染 markdown 依赖（mermaid 等）
              bindCommentActions(node.parentNode || node);
              if (typeof initMermaidIn === 'function') initMermaidIn([node]);
              if (showToast) showToast('评论已提交');
            } else {
              if (showToast) showToast(data.message || '评论失败，请重试');
            }
          })
          .catch(function() {
            if (btn) btn.disabled = false;
            if (showToast) showToast('提交失败，请重试');
          });
      });
    });
    scope.querySelectorAll('.comment-reply-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var commentId = this.dataset.commentId;
        var form = document.getElementById('reply-form-' + commentId);
        if (form) {
          form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
      });
    });

    scope.querySelectorAll('.comment-like-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var commentId = this.dataset.commentId;
        if (hasVote(commentId, 'like')) return;
        // 如果已经点过踩，不允许再点赞
        if (hasVote(commentId, 'dislike')) {
          alert('已点踩，不能再点赞');
          return;
        }
        setVote(commentId, 'like');
        btn.classList.add('active');
        var dislikeBtn = btn.parentElement.querySelector('.comment-dislike-btn');
        if (dislikeBtn) dislikeBtn.classList.remove('active');
        fetch('/comment/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'comment_id=' + commentId
        }).then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success) {
              var countSpan = btn.querySelector('span');
              countSpan.textContent = data.like_count;
            } else {
              clearVote(commentId, 'like');
              btn.classList.remove('active');
              if (data.message) alert(data.message);
            }
          })
          .catch(function() {
            clearVote(commentId, 'like');
            btn.classList.remove('active');
          });
      });
    });

    scope.querySelectorAll('.comment-dislike-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var commentId = this.dataset.commentId;
        if (hasVote(commentId, 'dislike')) return;
        // 如果已经点过赞，不允许再点踩
        if (hasVote(commentId, 'like')) {
          alert('已点赞，不能再点踩');
          return;
        }
        setVote(commentId, 'dislike');
        btn.classList.add('active');
        var likeBtn = btn.parentElement.querySelector('.comment-like-btn');
        if (likeBtn) likeBtn.classList.remove('active');
        fetch('/comment/dislike', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'comment_id=' + commentId
        }).then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success) {
              var countSpan = btn.querySelector('span');
              countSpan.textContent = data.dislike_count;
            } else {
              clearVote(commentId, 'dislike');
              btn.classList.remove('active');
              if (data.message) alert(data.message);
            }
          })
          .catch(function() {
            clearVote(commentId, 'dislike');
            btn.classList.remove('active');
          });
      });
    });

    // ========== QQ 邮箱自动填充昵称 ==========
    scope.querySelectorAll('.comment-form input[name="email"]').forEach(function(emailInput) {
      emailInput.addEventListener('input', function() {
        var form = this.closest('form');
        var nicknameInput = form.querySelector('input[name="nickname"]');
        if (!nicknameInput || nicknameInput.value.trim() !== '') return;

        var match = this.value.trim().match(/^(\d+)@qq\.com$/);
        if (!match) return;

        var qq = match[1];
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/qq-info?qq=' + qq, true);
        xhr.onload = function() {
          if (xhr.status === 200) {
            var data = JSON.parse(xhr.responseText);
            if (data.success) {
              nicknameInput.value = data.nickname;
            }
          }
        };
        xhr.send();
      });
    });

    // 子回复加载更多
    scope.querySelectorAll('.load-more-replies-btn[data-loaded="false"]').forEach(function(btn) {
      btn.setAttribute('data-loaded', 'true'); // 防止重复绑定
      btn.addEventListener('click', function() {
        loadMoreReplies(this);
      });
    });
  }

  // ===== Mermaid 图表增强：点击放大查看 + 下载为图片 =====
  function svgToPngDataUrl(svg, scale, cb) {
    var vb = svg.getAttribute('viewBox');
    var w = 0, h = 0;
    if (vb) {
      var parts = vb.split(/\s+/).map(Number);
      if (parts.length === 4) { w = parts[2]; h = parts[3]; }
    }
    if (!w || !h) {
      var rect = svg.getBoundingClientRect();
      w = rect.width; h = rect.height;
    }
    var clone = svg.cloneNode(true);
    clone.setAttribute('width', w);
    clone.setAttribute('height', h);
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    var xml = new XMLSerializer().serializeToString(clone);
    var img = new Image();
    img.onload = function() {
      var canvas = document.createElement('canvas');
      canvas.width = Math.round(w * scale);
      canvas.height = Math.round(h * scale);
      var ctx = canvas.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      cb(canvas.toDataURL('image/png'));
    };
    img.onerror = function() { cb(null); };
    img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml);
  }

  // 转义正则特殊字符
  function escapeRegExp(s) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  // 克隆 mermaid SVG 并重写内部 id：
  // mermaid 内嵌 <style> 以 svg 根 id 作为作用域（如 #mermaid-xxx .nodeLabel），
  // 直接克隆（或去掉 id）会导致作用域 CSS 失效、节点/文字变黑。
  function uniqueCloneSvg(svg) {
    var clone = svg.cloneNode(true);
    var prefix = 'mv-' + Date.now() + '-' + Math.floor(Math.random() * 1e5) + '-';
    var idMap = {};
    clone.querySelectorAll('[id]').forEach(function(el) {
      var oldId = el.getAttribute('id');
      if (!idMap[oldId]) {
        idMap[oldId] = prefix + oldId;
      }
      el.setAttribute('id', idMap[oldId]);
    });
    var ids = Object.keys(idMap);
    if (ids.length === 0) return clone;

    // 更新属性中的 url(#...) 引用（marker、clip-path 等）
    clone.querySelectorAll('*').forEach(function(el) {
      Array.prototype.forEach.call(el.attributes, function(attr) {
        if (attr.value && attr.value.indexOf('url(#') !== -1) {
          var v = attr.value;
          ids.forEach(function(oid) {
            v = v.replace(new RegExp('url\\(#' + escapeRegExp(oid) + '\\)', 'g'), 'url(#' + idMap[oid] + ')');
          });
          el.setAttribute(attr.name, v);
        }
      });
    });
    // 更新 href="#..." 引用
    clone.querySelectorAll('[href^="#"]').forEach(function(el) {
      var h = el.getAttribute('href').slice(1);
      if (idMap[h]) el.setAttribute('href', '#' + idMap[h]);
    });
    // 更新内嵌 <style> 中的作用域选择器
    clone.querySelectorAll('style').forEach(function(st) {
      var text = st.textContent;
      ids.forEach(function(oid) {
        text = text.replace(new RegExp('#' + escapeRegExp(oid) + '([^\\w-]|$)', 'g'), '#' + idMap[oid] + '$1');
      });
      st.textContent = text;
    });
    return clone;
  }

  function downloadMermaidSvg(svg) {
    showToast('正在生成图片…');
    svgToPngDataUrl(svg, 2, function(dataUrl) {
      if (!dataUrl) { showToast('图片生成失败'); return; }
      var a = document.createElement('a');
      a.href = dataUrl;
      a.download = 'chart-' + Date.now() + '.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('图片已下载');
    });
  }

  function enhanceMermaidChart(div) {
    var svg = div.querySelector('svg');
    if (!svg || div.dataset.enhanced) return;
    div.dataset.enhanced = '1';
    div.classList.add('mermaid-clickable');
    div.title = '点击放大查看';
    div.addEventListener('click', function() {
      var current = div.querySelector('svg');
      if (current) openMermaidViewer(current);
    });
  }

  function openMermaidViewer(svg) {
    var old = document.getElementById('mermaidViewer');
    if (old) old.parentNode.removeChild(old);

    var vb = svg.getAttribute('viewBox');
    var w = 0, h = 0;
    if (vb) {
      var p = vb.split(/\s+/).map(Number);
      if (p.length === 4) { w = p[2]; h = p[3]; }
    }
    if (!w || !h) {
      var r = svg.getBoundingClientRect();
      w = r.width; h = r.height;
    }

    var viewer = document.createElement('div');
    viewer.id = 'mermaidViewer';
    viewer.className = 'mermaid-viewer';

    // 工具栏
    var toolbar = document.createElement('div');
    toolbar.className = 'mermaid-viewer-toolbar';
    var title = document.createElement('span');
    title.className = 'mermaid-viewer-title';
    title.textContent = '图表预览（滚轮缩放 / 拖拽移动 / Esc 关闭）';
    toolbar.appendChild(title);

    function addBtn(text, handler) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'mermaid-viewer-btn';
      b.textContent = text;
      b.addEventListener('click', handler);
      toolbar.appendChild(b);
      return b;
    }
    addBtn('下载图片', function() { downloadMermaidSvg(svg); });
    addBtn('放大', function() { zoomBy(1.25); });
    addBtn('缩小', function() { zoomBy(1 / 1.25); });
    addBtn('重置', reset);
    addBtn('关闭', close);
    viewer.appendChild(toolbar);

    // 舞台
    var stage = document.createElement('div');
    stage.className = 'mermaid-viewer-stage';
    var inner = document.createElement('div');
    inner.className = 'mermaid-viewer-inner';
    var clone = uniqueCloneSvg(svg);
    clone.setAttribute('width', w);
    clone.setAttribute('height', h);
    inner.appendChild(clone);
    stage.appendChild(inner);
    viewer.appendChild(stage);
    document.body.appendChild(viewer);

    var scale = 1, tx = 0, ty = 0, initScale = 1;
    function apply() {
      inner.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + scale + ')';
    }
    function fit() {
      var sw = stage.clientWidth - 80, sh = stage.clientHeight - 80;
      if (sw <= 0 || sh <= 0) return;
      initScale = Math.min(sw / w, sh / h, 2);
      scale = initScale; tx = 0; ty = 0;
      apply();
    }
    function reset() { scale = initScale; tx = 0; ty = 0; apply(); }
    function zoomBy(factor) {
      scale = Math.min(20, Math.max(0.05, scale * factor));
      apply();
    }
    function zoomAt(cx, cy, factor) {
      var ns = Math.min(20, Math.max(0.05, scale * factor));
      var px = (cx - tx) / scale, py = (cy - ty) / scale;
      tx = cx - px * ns;
      ty = cy - py * ns;
      scale = ns;
      apply();
    }

    stage.addEventListener('wheel', function(e) {
      e.preventDefault();
      var rect = stage.getBoundingClientRect();
      zoomAt(e.clientX - rect.left - rect.width / 2, e.clientY - rect.top - rect.height / 2,
        e.deltaY < 0 ? 1.15 : 1 / 1.15);
    }, { passive: false });

    // 拖拽移动
    var dragging = false, lastX = 0, lastY = 0;
    stage.addEventListener('pointerdown', function(e) {
      if (e.button !== 0) return;
      dragging = true;
      lastX = e.clientX; lastY = e.clientY;
      stage.classList.add('dragging');
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', function(e) {
      if (!dragging) return;
      tx += e.clientX - lastX;
      ty += e.clientY - lastY;
      lastX = e.clientX; lastY = e.clientY;
      apply();
    });
    stage.addEventListener('pointerup', function() {
      dragging = false;
      stage.classList.remove('dragging');
    });
    stage.addEventListener('pointercancel', function() {
      dragging = false;
      stage.classList.remove('dragging');
    });

    function close() {
      if (viewer.parentNode) viewer.parentNode.removeChild(viewer);
      document.removeEventListener('keydown', onKey);
    }
    function onKey(e) { if (e.key === 'Escape') close(); }
    document.addEventListener('keydown', onKey);

    requestAnimationFrame(fit);
    window.addEventListener('resize', function onResize() {
      if (!viewer.parentNode) { window.removeEventListener('resize', onResize); return; }
      fit();
    });
  }

  function initMermaidIn(containers) {
    if (!containers || containers.length === 0) return;
    var mermaidNodes = [];
    containers.forEach(function(content) {
      if (!content) return;
      var pres = content.querySelectorAll('pre');
      pres.forEach(function(pre) {
        var code = pre.querySelector('code');
        var text = code ? (code.textContent || code.innerText) : pre.textContent;
        text = text.trim();
        if (!text) return;
        var mText = null;
        if (/^(graph |sequenceDiagram|classDiagram|erDiagram|gantt|flowchart |pie )/.test(text)) {
          mText = text;
        }
        if (text.indexOf('pie showData') === 0) {
          mText = text.replace(/^pie showData\s*\n\s*title\s+/, 'pie title ');
        }
        if (mText) {
          var div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = mText;
          pre.parentNode.replaceChild(div, pre);
          mermaidNodes.push(div);
        }
      });
    });

    if (mermaidNodes.length === 0) return;
    if (!Object.hasOwn) {
      Object.hasOwn = function(obj, prop) {
        return Object.prototype.hasOwnProperty.call(obj, prop);
      };
    }

    function runMermaid() {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'default',
        themeVariables: {
          primaryColor: '#e5e7eb',
          primaryTextColor: '#2a2c32',
          primaryBorderColor: '#9ca3af',
          lineColor: '#6b7280',
          secondaryColor: '#f3f4f6',
          tertiaryColor: '#f9fafb'
        }
      });
      mermaid.run({ nodes: mermaidNodes, suppressErrors: true }).then(function() {
        mermaidNodes.forEach(function(div) {
          if (div.parentNode && !div.querySelector('svg')) {
            var pre = document.createElement('pre');
            pre.className = 'mermaid-fallback';
            var code = document.createElement('code');
            code.textContent = div.textContent;
            pre.appendChild(code);
            div.parentNode.replaceChild(pre, div);
          }
        });
        setTimeout(function() {
          mermaidNodes.forEach(function(div) {
            var svg = div.querySelector('svg');
            if (svg) {
              var vb = svg.getAttribute('viewBox');
              if (vb && svg.textContent.indexOf('pie') !== -1) {
                var parts = vb.split(/\s+/).map(Number);
                if (parts.length === 4) {
                  parts[0] = -60;
                  parts[2] = parts[2] + 120;
                  svg.setAttribute('viewBox', parts.join(' '));
                }
              }
              enhanceMermaidChart(div);
            }
          });
        }, 100);
      });
    }

    if (typeof mermaid !== 'undefined') {
      runMermaid();
    } else {
      var s = document.createElement('script');
      s.src = '/lib/mermaid/mermaid.min.js';
      s.onload = runMermaid;
      document.body.appendChild(s);
    }
  }

  // 加载某个根评论下的更多子回复
  function loadMoreReplies(btn, preventRecursion) {
    if (btn.disabled) return; // 防止快速双击导致重复请求
    btn.disabled = true;
    var rootId = btn.dataset.rootId;
    var nextPage = parseInt(btn.dataset.nextPage || '1');
    var target = document.getElementById('comment-children-' + rootId);
    var url = '/comment/load?page_type=article&article_id=<%= article.id %>&root_id=' + rootId + '&child_page=' + nextPage;
    fetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.html) {
          // 直接把返回的 <li> 追加到当前根评论的 children 容器末尾，避免嵌套产生多余的边框
          var frag = document.createElement('div');
          frag.innerHTML = data.html;
          // children 是 live 集合，先快照再逐个移动，否则边移动边遍历会跳项丢失节点
          var nodes = Array.prototype.slice.call(frag.children);
          var inserted = [];
          nodes.forEach(function(node) {
            // 按 id 去重：页面已存在同 id 评论则跳过（如新评论插入导致分页偏移时的重叠）
            if (node.id && document.getElementById(node.id)) return;
            if (target) {
              target.appendChild(node);
            } else if (btn.parentNode) {
              btn.parentNode.insertBefore(node, btn);
            }
            bindCommentActions(node);
            inserted.push(node);
          });
          // 在真正插入 DOM 的节点上渲染 mermaid
          if (inserted.length > 0) initMermaidIn(inserted);
          if (data.remaining > 0) {
            btn.dataset.nextPage = data.nextPage;
            btn.textContent = '展开更多回复 (' + data.remaining + ')';
            btn.disabled = false;
          } else {
            if (btn.parentNode) btn.parentNode.removeChild(btn);
          }
        } else {
          btn.disabled = false;
        }
      })
      .catch(function() { btn.textContent = '加载失败，点击重试'; btn.disabled = false; });
  }

  function buttonAndRepliesHidden(loadMoreTopBtn) { ; }

  // 顶级评论加载更多
  function loadMoreComments(btn) {
    if (btn.disabled) return; // 防止快速双击导致重复请求
    btn.disabled = true;
    var nextPage = parseInt(btn.dataset.nextPage || '1');
    var list = document.getElementById('comments'); // 评论区容器
    var url = '/comment/load?page_type=article&article_id=<%= article.id %>&page=' + nextPage;
    fetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.html) {
          var wrap = document.createElement('div');
          wrap.innerHTML = data.html;
          // 追加到评论列表末尾（先快照，wrap.children 是 live 集合，边移动边遍历会跳项丢失节点）
          var target = document.querySelector('.comment-list') || null;
          var nodes = Array.prototype.slice.call(wrap.children);
          var inserted = [];
          nodes.forEach(function(node) {
            // 按 id 去重：页面已存在同 id 评论则跳过（如新评论插入导致分页偏移时的重叠）
            if (node.id && document.getElementById(node.id)) return;
            if (target) target.appendChild(node);
            else list.insertBefore(node, btn);
            bindCommentActions(node);
            inserted.push(node);
          });
          // 在真正插入 DOM 的节点上渲染 mermaid
          if (inserted.length > 0) initMermaidIn(inserted);
          if (data.hasMore) {
            btn.dataset.nextPage = data.nextPage;
            btn.disabled = false;
          } else {
            btn.parentNode.removeChild(btn);
          }
        } else {
          btn.disabled = false;
        }
      })
      .catch(function() { btn.textContent = '加载失败，点击重试'; btn.disabled = false; });
  }

  // 绑定顶级评论加载更多
  var loadMoreTopBtn = document.querySelector('.load-more-comments-btn[data-loaded="false"]');
  if (loadMoreTopBtn) {
    loadMoreTopBtn.setAttribute('data-loaded', 'true');
    loadMoreTopBtn.addEventListener('click', function() { loadMoreComments(this); });
  }

  // 初始绑定评论交互 + 渲染初始 mermaid
  loadCommentCache();
  bindCommentActions(document);
  initMermaidIn([document.getElementById('articleContent'), document.getElementById('comments')]);
// ========== 悬浮目录 (TOC) ==========
  (function() {
    var content = document.getElementById('articleContent');
    if (!content) return;

    // 只显示章节级标题（markdown ## 渲染为 h2），避免误判
    var headings = content.querySelectorAll('h2');
    if (headings.length < 2) return;

    // 构建 TOC 数据
    var items = [];
    headings.forEach(function(h) {
      items.push({
        tag: h.tagName.toLowerCase(),
        text: h.textContent.trim(),
        el: h
      });
    });

    // 创建 DOM
    var toc = document.createElement('div');
    toc.className = 'toc-float';
    toc.innerHTML =
      '<div class="toc-float-header">' +
        '<span class="toc-float-title">目录</span>' +
        '<button class="toc-float-close" aria-label="关闭">&#x2715;</button>' +
      '</div>' +
      '<div class="toc-float-body"><ul class="toc-float-list"></ul></div>';
    var list = toc.querySelector('.toc-float-list');
    var closeBtn = toc.querySelector('.toc-float-close');

    // 填充目录项
    items.forEach(function(item) {
      var li = document.createElement('li');
      li.className = 'toc-float-item';
      var a = document.createElement('a');
      a.textContent = item.text;
      a.addEventListener('click', function(e) {
        e.preventDefault();
        item.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        // 移动端点击后自动收起
        if (window.innerWidth <= 768) {
          toc.classList.remove('visible');
        }
      });
      li.appendChild(a);
      list.appendChild(li);
    });

    document.body.appendChild(toc);

    // 关闭按钮
    closeBtn.addEventListener('click', function() {
      if (window.innerWidth <= 768) {
        toc.classList.remove('visible');
      } else {
        toc.style.display = 'none';
      }
    });

    // 拖拽（仅桌面端）
    if (window.innerWidth > 768) {
      var dragHandle = toc.querySelector('.toc-float-header');
      var isDragging = false, startX, startY, origLeft, origTop;

      dragHandle.addEventListener('pointerdown', function(e) {
        if (e.target.closest('.toc-float-close')) return;
        isDragging = true;
        dragHandle.setPointerCapture(e.pointerId);
        startX = e.clientX;
        startY = e.clientY;
        origLeft = toc.offsetLeft;
        origTop = toc.offsetTop;
        toc.style.cursor = 'grabbing';
        toc.style.transition = 'none';
      });

      dragHandle.addEventListener('pointermove', function(e) {
        if (!isDragging) return;
        var dx = e.clientX - startX;
        var dy = e.clientY - startY;
        toc.style.left = Math.max(0, origLeft + dx) + 'px';
        toc.style.top = Math.max(0, origTop + dy) + 'px';
      });

      dragHandle.addEventListener('pointerup', function() {
        isDragging = false;
        toc.style.cursor = 'move';
        toc.style.transition = '';
      });

      dragHandle.addEventListener('pointercancel', function() {
        isDragging = false;
        toc.style.cursor = 'move';
        toc.style.transition = '';
      });

      // 双击标题栏复位
      dragHandle.addEventListener('dblclick', function() {
        toc.style.left = '';
        toc.style.top = '';
      });
    }

    // 移动端切换按钮
    var toggle = document.createElement('button');
    toggle.className = 'toc-float-toggle';
    toggle.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>';
    toggle.setAttribute('aria-label', '显示目录');
    toggle.addEventListener('click', function() {
      toc.classList.toggle('visible');
    });
    document.body.appendChild(toggle);

    // 点击页面其他区域关闭（toggle.contains 兼容点击到按钮内 SVG 的情况）
    document.addEventListener('click', function(e) {
      if (window.innerWidth > 768) return;
      if (toc.classList.contains('visible') && !toc.contains(e.target) && !toggle.contains(e.target)) {
        toc.classList.remove('visible');
      }
    });

    // 滚动高亮当前标题
    var activeItem = null;
    function updateActive() {
      if (window.innerWidth <= 768) return;
      var scrollY = window.scrollY + 100;
      var matched = null;
      for (var i = headings.length - 1; i >= 0; i--) {
        if (headings[i].offsetTop <= scrollY) {
          matched = headings[i];
          break;
        }
      }
      var links = list.querySelectorAll('a');
      links.forEach(function(link) { link.style.fontWeight = ''; });
      if (matched) {
        var idx = Array.prototype.indexOf.call(headings, matched);
        if (links[idx]) {
          links[idx].style.fontWeight = '600';
        }
      }
    }
    window.addEventListener('scroll', function() {
      clearTimeout(window._tocTimer);
      window._tocTimer = setTimeout(updateActive, 80);
    });
    updateActive();
  })();
})();
</script>

<% } else { %>
<div class="empty-state">
  <p>文章不存在或已被删除</p>
</div>
<% } %>