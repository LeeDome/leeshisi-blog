<div class="tools-container">
  <header class="tools-header">
    <h1 class="tools-title">图片极限压缩</h1>
    <p class="tools-desc">JPG / PNG / WebP · 暴力压缩至30KB以下 · 纯本地处理</p>
  </header>

  <div class="tools-card">
    <!-- 格式选择 -->
    <div class="tools-format-row">
      <label class="tools-label">选择输出格式：</label>
      <select id="formatSelect" class="tools-select">
        <option value="webp">WebP (推荐，体积最小)</option>
        <option value="jpg">JPG (通用格式)</option>
        <option value="png">PNG (无损透明)</option>
      </select>
      <span class="tools-hint">PNG为无损格式，会自动缩放尺寸保证≤30KB</span>
    </div>

    <!-- 上传区域 -->
    <div class="tools-upload-box" id="uploadArea">
      <input type="file" id="fileInput" accept="image/*" class="tools-file-input">
      <div class="tools-upload-inner">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" class="tools-upload-icon">
          <path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
        </svg>
        <p class="tools-upload-text">点击或拖拽图片到此处上传</p>
        <p class="tools-upload-sub">支持所有图片格式，自动压缩到30KB以下</p>
      </div>
    </div>

    <!-- 预览对比 -->
    <div class="tools-preview-grid" id="previewContainer" style="display:none">
      <div class="tools-preview-card">
        <h3 class="tools-preview-title">原图</h3>
        <div class="tools-preview-img-box">
          <img id="originalImg" class="tools-preview-img">
        </div>
        <p id="originalSize" class="tools-preview-info">大小：加载中...</p>
      </div>
      <div class="tools-preview-card">
        <h3 class="tools-preview-title">压缩图 <span class="tools-badge">≤30KB</span></h3>
        <div class="tools-preview-img-box">
          <img id="compressedImg" class="tools-preview-img">
        </div>
        <p id="compressedSize" class="tools-preview-info">大小：压缩中...</p>
        <p id="compressRate" class="tools-preview-rate">压缩率：计算中...</p>
        <p id="outputFormat" class="tools-preview-info">输出格式：加载中...</p>
      </div>
    </div>

    <!-- 下载按钮 -->
    <div class="tools-download" id="downloadContainer" style="display:none">
      <button id="downloadBtn" class="tools-btn-download">下载压缩后的图片</button>
      <p class="tools-download-hint">图片已严格控制在30KB以内，格式为选中类型</p>
    </div>
  </div>
</div>

<style>
  /* ========== 工具页面样式 ========== */
  .tools-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .tools-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .tools-title {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .tools-desc {
    color: var(--text-secondary);
    font-size: 0.95em;
  }

  .tools-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 32px;
  }

  .tools-format-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .tools-label {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95em;
  }

  .tools-select {
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.95em;
    cursor: pointer;
    outline: none;
  }

  .tools-select:focus {
    border-color: var(--accent);
  }

  .tools-hint {
    font-size: 0.85em;
    color: var(--text-secondary);
    width: 100%;
  }

  .tools-upload-box {
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    padding: 48px 24px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: 24px;
  }

  .tools-upload-box:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .tools-file-input {
    display: none;
  }

  .tools-upload-icon {
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .tools-upload-text {
    font-size: 1.1em;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .tools-upload-sub {
    font-size: 0.85em;
    color: var(--text-secondary);
  }

  .tools-preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }

  .tools-preview-card {
    background: var(--bg-body);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .tools-preview-title {
    font-size: 0.95em;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .tools-badge {
    color: #00b42a;
    font-weight: 700;
  }

  .tools-preview-img-box {
    background: #f0f0f0;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 10px;
    aspect-ratio: 16 / 10;
  }

  .tools-preview-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .tools-preview-info {
    font-size: 0.85em;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .tools-preview-rate {
    font-size: 0.85em;
    color: var(--accent);
    font-weight: 500;
    margin-top: 4px;
  }

  .tools-download {
    text-align: center;
  }

  .tools-btn-download {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 12px 40px;
    border-radius: var(--radius-sm);
    font-size: 1em;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .tools-btn-download:hover {
    opacity: 0.9;
  }

  .tools-download-hint {
    font-size: 0.82em;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .tools-preview-grid {
      grid-template-columns: 1fr;
    }
    .tools-card {
      padding: 20px;
    }
  }
</style>

<script>
(function() {
  var TARGET_SIZE = 30 * 1024;
  var MAX_WIDTH = 1600;
  var MIN_WIDTH = 20;
  var MAX_ITERATIONS = 50;

  var uploadArea = document.getElementById('uploadArea');
  var fileInput = document.getElementById('fileInput');
  var formatSelect = document.getElementById('formatSelect');
  var previewContainer = document.getElementById('previewContainer');
  var downloadContainer = document.getElementById('downloadContainer');
  var originalImg = document.getElementById('originalImg');
  var compressedImg = document.getElementById('compressedImg');
  var originalSize = document.getElementById('originalSize');
  var compressedSize = document.getElementById('compressedSize');
  var compressRate = document.getElementById('compressRate');
  var outputFormat = document.getElementById('outputFormat');
  var downloadBtn = document.getElementById('downloadBtn');

  var compressedBlob = null;
  var currentFormat = 'webp';

  var formatMap = {
    jpg: 'image/jpeg',
    png: 'image/png',
    webp: 'image/webp'
  };

  formatSelect.addEventListener('change', function() {
    currentFormat = formatSelect.value;
    if (fileInput.files[0]) {
      compressImage(fileInput.files[0]);
    }
  });

  uploadArea.addEventListener('click', function() { fileInput.click(); });

  uploadArea.addEventListener('dragover', function(e) {
    e.preventDefault();
    uploadArea.style.borderColor = 'var(--accent)';
  });

  uploadArea.addEventListener('dragleave', function() {
    uploadArea.style.borderColor = '';
  });

  uploadArea.addEventListener('drop', function(e) {
    e.preventDefault();
    uploadArea.style.borderColor = '';
    var file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) {
      fileInput.files = e.dataTransfer.files;
      handleImageFile(file);
    }
  });

  fileInput.addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (file) handleImageFile(file);
  });

  function handleImageFile(file) {
    var originalUrl = URL.createObjectURL(file);
    originalImg.src = originalUrl;
    originalSize.textContent = '大小：' + formatFileSize(file.size);
    previewContainer.style.display = 'grid';
    compressImage(file);
  }

  function compressImage(file) {
    var reader = new FileReader();
    reader.readAsDataURL(file);
    var mimeType = formatMap[currentFormat];

    reader.onload = function(e) {
      var img = new Image();
      img.src = e.target.result;

      img.onload = function() {
        var origW = img.width;
        var origH = img.height;
        var width = Math.min(origW, MAX_WIDTH);
        var height = width * (origH / origW);
        var quality = 0.8;
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        var iterations = 0;

        function compress() {
          iterations++;
          if (iterations > MAX_ITERATIONS) {
            // 兜底：用最小尺寸再试最后一次
            width = MIN_WIDTH;
            height = MIN_WIDTH * (origH / origW);
          }

          canvas.width = Math.round(width);
          canvas.height = Math.round(height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

          canvas.toBlob(
            function(blob) {
              if (!blob) {
                showCompressedResult(null, file.size);
                return;
              }
              if (blob.size <= TARGET_SIZE || width <= MIN_WIDTH || iterations >= MAX_ITERATIONS) {
                compressedBlob = blob;
                showCompressedResult(blob, file.size);
              } else {
                // 所有格式都缩小尺寸 + 降低质量
                if (currentFormat === 'png') {
                  // PNG 无损，质量参数无效，只能大幅缩尺寸
                  width *= 0.6;
                } else {
                  quality -= 0.15;
                  if (quality < 0.2) {
                    quality = 0.2;
                    width *= 0.7;
                  }
                }
                height = width * (origH / origW);
                compress();
              }
            },
            mimeType,
            quality
          );
        }
        compress();
      };
    };
  }

  function showCompressedResult(blob, originalSizeBytes) {
    if (!blob) {
      compressedSize.textContent = '压缩失败，请重试';
      return;
    }
    var url = URL.createObjectURL(blob);
    compressedImg.src = url;
    compressedSize.textContent = '大小：' + formatFileSize(blob.size);
    var rate = ((1 - blob.size / originalSizeBytes) * 100).toFixed(1);
    compressRate.textContent = '压缩率：' + rate + '%';
    outputFormat.textContent = '输出格式：' + currentFormat.toUpperCase();
    downloadContainer.style.display = 'block';
  }

  downloadBtn.addEventListener('click', function() {
    if (!compressedBlob) return;
    var a = document.createElement('a');
    a.href = URL.createObjectURL(compressedBlob);
    a.download = 'compressed_' + new Date().getTime() + '.' + currentFormat;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    return (bytes / 1024).toFixed(2) + ' KB';
  }
})();
</script>